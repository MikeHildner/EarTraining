<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Components.PickerField">
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <ContentPresenter />
                <!-- Painted after the presenter, so it sits on top; InputTransparent lets the
                     tap fall through to the Picker underneath. Muted matches the Picker's own
                     TitleColor (App.xaml), so it reads as part of the control, not a button. -->
                <Label x:Name="Chevron" Text="▾" FontSize="12"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA0AA}"
                       HorizontalOptions="End" VerticalOptions="Center"
                       Margin="0,0,4,0" InputTransparent="True" />
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
