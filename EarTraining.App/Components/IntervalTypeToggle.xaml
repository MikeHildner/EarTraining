<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Components.IntervalTypeToggle">
    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
        <Label Text="Drill these intervals:" HorizontalOptions="Center" FontSize="13" TextColor="Gray" />
        <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
            <RadioButton x:Name="Maj3" Content="Maj 3rd" GroupName="ivltype" IsChecked="True" CheckedChanged="OnChanged" />
            <RadioButton x:Name="Min6" Content="Min 6th" GroupName="ivltype" CheckedChanged="OnChanged" />
            <RadioButton x:Name="BothBtn" Content="Both" GroupName="ivltype" CheckedChanged="OnChanged" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
