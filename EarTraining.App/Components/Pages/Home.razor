@page "/"
@using EarTraining.Core.Audio
@using EarTraining.Core.Theory
@using EarTraining.Core.Drills
@using EarTraining.App.Services
@using Microsoft.JSInterop
@inject SampleLibrary Samples
@inject IJSRuntime JS

<h1 class="mb-1">Interval ID</h1>
<p class="text-muted mb-3">Play the interval, then pick what you heard.</p>

<div class="d-grid gap-2 col-10 mx-auto mb-3">
    <button class="btn btn-primary btn-lg" @onclick="PlayMelodic" disabled="@busy">Play (melodic)</button>
    <button class="btn btn-outline-primary" @onclick="PlayHarmonic" disabled="@busy">Play (harmonic)</button>
</div>

<div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
    @foreach (var opt in IntervalDrill.Options)
    {
        <button class="btn @ButtonClass(opt)" style="min-width:64px"
                @onclick="() => Answer(opt)" disabled="@(answered || busy || drill is null)">
            @opt.ShortName
        </button>
    }
</div>

<p class="text-center fw-semibold" style="min-height:1.5rem">@status</p>

@if (answered)
{
    <div class="d-grid col-6 mx-auto mb-3">
        <button class="btn btn-dark" @onclick="Next">Next</button>
    </div>
}

<p class="text-center text-muted">Score: @correct / @total</p>

@code {
    readonly Random rng = new();
    IntervalDrill? drill;
    bool busy;
    bool answered;
    int correct;
    int total;
    int? pickedSemitones;
    string status = "";

    protected override void OnInitialized() => drill = IntervalDrill.Next(rng);

    Task PlayMelodic() => Play(melodic: true);
    Task PlayHarmonic() => Play(melodic: false);

    async Task Play(bool melodic)
    {
        if (drill is null || busy) return;
        busy = true;
        try
        {
            var lo = await Samples.LoadAsync(Note.SampleFile(drill.LowNote));
            var hi = await Samples.LoadAsync(Note.SampleFile(drill.HighNote));
            var notes = new[] { lo, hi };
            var wav = melodic ? AudioRenderer.RenderMelodic(notes) : AudioRenderer.RenderHarmonic(notes);
            await JS.InvokeVoidAsync("playWavBase64", Convert.ToBase64String(wav));
        }
        catch (Exception ex)
        {
            status = "Error: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    void Answer(Interval opt)
    {
        if (drill is null || answered) return;
        answered = true;
        pickedSemitones = opt.Semitones;
        total++;
        status = opt.Semitones == drill.Answer.Semitones
            ? $"Correct - {drill.Answer.Name}  ({drill.LowName} to {drill.HighName})"
            : $"Nope - it was {drill.Answer.Name}  ({drill.LowName} to {drill.HighName})";
        if (opt.Semitones == drill.Answer.Semitones) correct++;
    }

    void Next()
    {
        drill = IntervalDrill.Next(rng);
        answered = false;
        pickedSemitones = null;
        status = "";
    }

    string ButtonClass(Interval opt)
    {
        if (!answered || drill is null) return "btn-outline-secondary";
        if (opt.Semitones == drill.Answer.Semitones) return "btn-success";
        if (pickedSemitones == opt.Semitones) return "btn-danger";
        return "btn-outline-secondary";
    }
}
