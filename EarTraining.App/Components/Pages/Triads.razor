@page "/triads"
@using EarTraining.Core.Audio
@using EarTraining.Core.Theory
@using EarTraining.Core.Drills
@using EarTraining.App.Services
@using Microsoft.JSInterop
@inject SampleLibrary Samples
@inject IJSRuntime JS

<h1 class="mb-1">Triad ID</h1>
<p class="text-muted mb-3">Play the triad, then pick its quality.</p>

<div class="d-grid gap-2 col-10 mx-auto mb-3">
    <button class="btn btn-primary btn-lg" @onclick="PlayHarmonic" disabled="@busy">Play (chord)</button>
    <button class="btn btn-outline-primary" @onclick="PlayMelodic" disabled="@busy">Play (arpeggio)</button>
</div>

<div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
    @foreach (var opt in TriadDrill.Options)
    {
        <button class="btn @ButtonClass(opt)" style="min-width:84px"
                @onclick="() => Answer(opt)" disabled="@(answered || busy || drill is null)">
            @opt.ShortName
        </button>
    }
</div>

<p class="text-center fw-semibold" style="min-height:1.5rem">@status</p>

@if (answered)
{
    <div class="d-grid col-6 mx-auto mb-3">
        <button class="btn btn-dark" @onclick="Next">Next</button>
    </div>
}

<p class="text-center text-muted">Score: @correct / @total</p>

@code {
    readonly Random rng = new();
    TriadDrill? drill;
    bool busy;
    bool answered;
    int correct;
    int total;
    string? pickedName;
    string status = "";

    protected override void OnInitialized() => drill = TriadDrill.Next(rng);

    Task PlayHarmonic() => Play(harmonic: true);
    Task PlayMelodic() => Play(harmonic: false);

    async Task Play(bool harmonic)
    {
        if (drill is null || busy) return;
        busy = true;
        try
        {
            var notes = new List<byte[]>();
            foreach (var n in drill.NoteNumbers)
                notes.Add(await Samples.LoadAsync(Note.SampleFile(n)));

            var wav = harmonic ? AudioRenderer.RenderHarmonic(notes) : AudioRenderer.RenderMelodic(notes);
            await JS.InvokeVoidAsync("playWavBase64", Convert.ToBase64String(wav));
        }
        catch (Exception ex)
        {
            status = "Error: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    void Answer(TriadQuality opt)
    {
        if (drill is null || answered) return;
        answered = true;
        pickedName = opt.Name;
        total++;
        status = opt.Name == drill.Answer.Name
            ? $"Correct - {drill.Answer.Name} ({drill.RootName})"
            : $"Nope - it was {drill.Answer.Name} ({drill.RootName})";
        if (opt.Name == drill.Answer.Name) correct++;
    }

    void Next()
    {
        drill = TriadDrill.Next(rng);
        answered = false;
        pickedName = null;
        status = "";
    }

    string ButtonClass(TriadQuality opt)
    {
        if (!answered || drill is null) return "btn-outline-secondary";
        if (opt.Name == drill.Answer.Name) return "btn-success";
        if (pickedName == opt.Name) return "btn-danger";
        return "btn-outline-secondary";
    }
}
