<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Components.TonicHeader">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto">
        <Label x:Name="DoLabel" Grid.Column="0" VerticalOptions="Center" FontAttributes="Bold" FontSize="18" />
        <Button x:Name="PlayDoButton" Grid.Column="1" Text="▶ Play DO" Clicked="OnPlayDo" />
        <Button x:Name="NewDoButton" Grid.Column="2" Text="↻ New DO" Clicked="OnNewDo" />
    </Grid>
</ContentView>
