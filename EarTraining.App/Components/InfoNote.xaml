<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Components.InfoNote">
    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
        <Button x:Name="ToggleButton" Text="ⓘ  Book reference" Clicked="OnToggle"
                BackgroundColor="Transparent" TextColor="#512BD4" BorderWidth="0"
                FontSize="13" Padding="6,2" MinimumHeightRequest="0" HorizontalOptions="Center" />
        <Label x:Name="NoteLabel" IsVisible="False" TextColor="Gray" FontSize="13"
               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
