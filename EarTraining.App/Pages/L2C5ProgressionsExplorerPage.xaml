<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.L2C5ProgressionsExplorerPage"
             Title="Diatonic Triad Progressions">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Diatonic Triad Progressions" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="An explorer: a random four-chord diatonic progression in a random key. No scoring — just listen and follow the harmony."
                   HorizontalOptions="Center" TextColor="Gray" />
            <Border HorizontalOptions="Center" BackgroundColor="#FAEEDA" Stroke="#EF9F27" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="10,3" Margin="0,2,0,0">
                <Label Text="Work in progress" TextColor="#854F0B" FontSize="12" />
            </Border>
            <c:InfoNote Text="Designed from the diatonic triad progression questions on pp. 69–71." />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Start on the tonic (I)" VerticalOptions="Center" />
                <Switch x:Name="TonicFirstSwitch" IsToggled="True" Toggled="OnTonicToggled" />
            </HorizontalStackLayout>

            <Button Text="▶ Play progression" Clicked="OnPlay" />
            <Button x:Name="NextButton" Text="↻ New Progression" Clicked="OnNext" HorizontalOptions="Center" WidthRequest="220" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
