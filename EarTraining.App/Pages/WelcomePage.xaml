<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.WelcomePage"
             Title="Welcome">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B8CEF" Offset="0.0" />
            <GradientStop Color="#6A5AE6" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout VerticalOptions="Center" Spacing="20" Padding="32">
        <Image Source="welcome_ear.png" HeightRequest="190" HorizontalOptions="Center" />
        <Label Text="Ear Training" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
        <c:ScoreGauge x:Name="Gauge" ShowTally="False" GaugeSize="200" PercentTextColor="White"
                      HorizontalOptions="Center" Margin="0,6,0,0" />
        <Label Text="Let's make you a better musician." FontSize="16" TextColor="#ECE7FF" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
