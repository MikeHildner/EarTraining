<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.BlankSheetPage"
             Title="Blank Sheet Music">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Blank Sheet Music" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Share a PDF of blank staff paper for transcribing the dictation drills — print it, email it, or save it."
                   HorizontalTextAlignment="Center" TextColor="Gray" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <Label Text="Clef" VerticalOptions="Center" />
                    <c:PickerField Grid.Column="1">
                        <Picker x:Name="ClefPicker" />
                    </c:PickerField>
                    <Label Text="Key signature" Grid.Row="1" VerticalOptions="Center" />
                    <c:PickerField Grid.Row="1" Grid.Column="1">
                        <Picker x:Name="KeyPicker" />
                    </c:PickerField>
                    <Label Text="Time signature" Grid.Row="2" VerticalOptions="Center" />
                    <c:PickerField Grid.Row="2" Grid.Column="1">
                        <Picker x:Name="TimePicker" />
                    </c:PickerField>
                    <Label Text="Measures per line" Grid.Row="3" VerticalOptions="Center" />
                    <c:PickerField Grid.Row="3" Grid.Column="1">
                        <Picker x:Name="MeasuresPicker" />
                    </c:PickerField>
                    <Label Text="Staves per page" Grid.Row="4" VerticalOptions="Center" />
                    <c:PickerField Grid.Row="4" Grid.Column="1">
                        <Picker x:Name="StavesPicker" />
                    </c:PickerField>
                    <Label Text="Landscape" Grid.Row="5" VerticalOptions="Center" />
                    <Switch x:Name="LandscapeSwitch" Grid.Row="5" Grid.Column="1" HorizontalOptions="Start" />
                </Grid>
            </Border>

            <Button x:Name="ShareButton" Text="Share PDF" Clicked="OnSharePdf" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />

            <!-- The preview is paper: it stays white in both themes, like the notation reveals. -->
            <WebView x:Name="NotationWeb" HeightRequest="520" BackgroundColor="White" Navigated="OnNavigated" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
