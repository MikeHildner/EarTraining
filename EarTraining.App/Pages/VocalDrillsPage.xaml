<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.VocalDrillsPage"
             Title="Vocal Drills">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Vocal Drills" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Play the drill, sing along, then identify the resolution."
                   HorizontalOptions="Center" TextColor="Gray" />
            <c:TonicHeader x:Name="DoHeader" />
            <Button Text="Play drill" Clicked="OnPlay" />
            <Label Text="Which resolution did you hear?" FontAttributes="Bold" HorizontalOptions="Center" />
            <FlexLayout x:Name="AnswersLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
            <Button x:Name="NextButton" Text="New Drill" Clicked="OnNext" HorizontalOptions="Center" WidthRequest="200" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />
            <c:ScoreGauge x:Name="Gauge" HorizontalOptions="Center" />
            <c:IncludeToggles x:Name="Includes" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
