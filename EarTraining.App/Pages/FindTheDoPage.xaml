<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.FindTheDoPage"
             Title="Find the DO">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Find the DO" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Hear the tonic (DO) in a random key, then name its pitch. The DO stays hidden until you answer."
                   HorizontalOptions="Center" TextColor="Gray" />
            <Button Text="▶ Play DO" Clicked="OnPlay" />
            <Label Text="Which note is the DO?" FontAttributes="Bold" HorizontalOptions="Center" />
            <FlexLayout x:Name="AnswersLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
            <Button x:Name="NextButton" Text="↻ New DO" Clicked="OnNext" HorizontalOptions="Center" WidthRequest="200" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />
            <c:ScoreGauge x:Name="Gauge" HorizontalOptions="Center" />
            <c:AutomationBar x:Name="Automation" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
