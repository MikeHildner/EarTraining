<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Pages.TriadPage"
             Title="Triad ID">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Play the triad, then pick its quality." HorizontalOptions="Center" />
            <Button Text="▶ Play (chord)" Clicked="OnPlayChord" />
            <Button Text="▶ Play (arpeggio)" Clicked="OnPlayArpeggio" />
            <FlexLayout x:Name="OptionsLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />
            <Button x:Name="NextButton" Text="↻ Next" Clicked="OnNext" IsVisible="False" HorizontalOptions="Center" WidthRequest="160" />
            <Label x:Name="ScoreLabel" Text="Score: 0 / 0" HorizontalOptions="Center" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
