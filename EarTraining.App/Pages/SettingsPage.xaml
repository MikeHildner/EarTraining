<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.SettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Settings" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Appearance" Style="{StaticResource Heading}" />
                    <c:PickerField>
                        <Picker x:Name="ThemePicker" Title="Theme" />
                    </c:PickerField>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Practice key" Style="{StaticResource Heading}" />
                    <Label Text="Fix the DO for every drill, or keep it random. Applies to the DO-based drills and sets the default key for Dictation (not Level 2)."
                           TextColor="Gray" FontSize="12.5" />
                    <c:PickerField>
                        <Picker x:Name="KeyPicker" Title="Key" />
                    </c:PickerField>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Volume" Style="{StaticResource Heading}" />
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" />
                    <Label x:Name="VolumeLabel" TextColor="Gray" FontSize="12.5" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Automation" Style="{StaticResource Heading}" />
                    <Label Text="How long Automation waits between drills."
                           TextColor="Gray" FontSize="12.5" />
                    <c:PickerField>
                        <Picker x:Name="PacePicker" Title="Pace" />
                    </c:PickerField>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
