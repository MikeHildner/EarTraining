<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Pages.HomePage"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Border StrokeShape="RoundRectangle 22" HeightRequest="104" WidthRequest="104"
                    HorizontalOptions="Center" Padding="10" Stroke="Transparent" Margin="0,8,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9B8CEF" Offset="0" />
                        <GradientStop Color="#6A5AE6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Image Source="welcome_ear.png" Aspect="AspectFit" />
            </Border>
            <Label Text="Ear Training" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="What would you like to practice?" HorizontalOptions="Center" TextColor="Gray" Margin="0,0,0,6" />

            <!-- Search: type to filter every drill by name/chapter; results replace the accordion. -->
            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0DCF5, Dark=#383150}"
                    BackgroundColor="{AppThemeBinding Light=#F5F3FC, Dark=#211E30}" Padding="12,2">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="&#xf002;" FontFamily="FA" FontSize="15" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
                    <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Search…"
                           PlaceholderColor="{AppThemeBinding Light=#6B7280, Dark=#9AA0AA}"
                           TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#E4E2EA}"
                           BackgroundColor="Transparent" ReturnType="Search"
                           TextChanged="OnSearchChanged" />
                    <Label x:Name="SearchClear" Grid.Column="2" Text="✕" FontSize="16" Padding="6,0" IsVisible="False"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9AA0AA}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchClear" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <!-- Search hits (built in code-behind); hidden unless a query is active. -->
            <VerticalStackLayout x:Name="SearchResults" Spacing="8" IsVisible="False" />

            <!-- Chapters are built in code-behind as a single-open accordion. -->
            <VerticalStackLayout x:Name="ChaptersContainer" Spacing="0" />

            <!-- Quick-action tiles (icons mirror the flyout glyphs). -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,18,0,8">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 14" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0DCF5, Dark=#383150}"
                        BackgroundColor="{AppThemeBinding Light=#F5F3FC, Dark=#211E30}" Padding="6,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProgress" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                        <Label Text="&#xf201;" FontFamily="FA" FontSize="23" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
                        <Label Text="Progress" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3C3489, Dark=#CFC6F2}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0DCF5, Dark=#383150}"
                        BackgroundColor="{AppThemeBinding Light=#F5F3FC, Dark=#211E30}" Padding="6,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettings" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                        <Label Text="&#xf013;" FontFamily="FA" FontSize="23" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
                        <Label Text="Settings" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3C3489, Dark=#CFC6F2}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" StrokeShape="RoundRectangle 14" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0DCF5, Dark=#383150}"
                        BackgroundColor="{AppThemeBinding Light=#F5F3FC, Dark=#211E30}" Padding="6,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAbout" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                        <Label Text="&#xf05a;" FontFamily="FA" FontSize="23" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
                        <Label Text="About" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3C3489, Dark=#CFC6F2}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
