<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.TriadRecognitionL1C3Page"
             Title="Triad Recognition">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Diatonic Triad Recognition" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Play the triad, then identify it (I / IV / V)."
                   HorizontalOptions="Center" TextColor="Gray" />
            <c:InfoNote Text="Selected from the diatonic triad identification questions on p. 54." />
            <c:TonicHeader x:Name="DoHeader" />
            <Button Text="▶ Play triad" Clicked="OnPlay" />

            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                <Label Text="Identify:" HorizontalOptions="Center" FontSize="13" TextColor="Gray" />
                <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                    <RadioButton x:Name="ScoreTriadRadio" Content="Triad (I / IV / V)" GroupName="scoremode" IsChecked="True" CheckedChanged="OnScoreModeChanged" />
                    <RadioButton x:Name="ScoreBothRadio" Content="Triad + inversion" GroupName="scoremode" CheckedChanged="OnScoreModeChanged" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="Which triad did you hear?" FontAttributes="Bold" HorizontalOptions="Center" />
            <FlexLayout x:Name="AnswersLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
            <Button x:Name="NextButton" Text="↻ New Triad" Clicked="OnNext" HorizontalOptions="Center" WidthRequest="200" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />
            <c:ScoreGauge x:Name="Gauge" HorizontalOptions="Center" />
            <c:AutomationBar x:Name="Automation" />
            <Button Text="Invert Selections" Clicked="OnInvert" HorizontalOptions="Center" WidthRequest="200"
                    BackgroundColor="Transparent" TextColor="#512BD4" BorderColor="#512BD4" BorderWidth="1" />
            <c:IncludeToggles x:Name="Includes" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
