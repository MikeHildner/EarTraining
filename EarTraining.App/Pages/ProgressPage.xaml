<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Pages.ProgressPage"
             Title="Progress">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Your Progress" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Saved on this device only." FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
            <VerticalStackLayout x:Name="StatsHost" Spacing="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
