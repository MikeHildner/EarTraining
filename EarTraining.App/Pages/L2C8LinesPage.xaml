<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.L2C8LinesPage"
             Title="7-3 Lines">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="7–3 Melodic Lines" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="A II–V–I plays with one of its two 7-3 lines on top — which line did you hear?"
                   HorizontalOptions="Center" TextColor="Gray" />
            <c:InfoNote Text="Selected from the 7-3 melodic line questions on pp. 79–82. The 7–3–7 line moves DO–TI–TI (half-step, then commontone); the 3–7–3 line moves FA–FA–MI (commontone, then half-step)." />

            <Button Text="▶ Play II–V–I with melody" Clicked="OnPlay" />
            <Label Text="Which 7-3 line was the melody?" FontAttributes="Bold" HorizontalOptions="Center" />
            <FlexLayout x:Name="AnswersLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
            <Button x:Name="NextButton" Text="↻ New Drill" Clicked="OnNext" HorizontalOptions="Center" WidthRequest="200" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />
            <c:ScoreGauge x:Name="Gauge" HorizontalOptions="Center" />
            <c:AutomationBar x:Name="Automation" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
