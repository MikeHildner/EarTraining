<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.IntervalPage"
             Title="Interval ID">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Play the interval, then pick what you heard." HorizontalOptions="Center" />
            <Button Text="▶ Play (melodic)" Clicked="OnPlayMelodic" />
            <Button Text="▶ Play (harmonic)" Clicked="OnPlayHarmonic" />
            <FlexLayout x:Name="OptionsLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />
            <Button x:Name="NextButton" Text="↻ Next" Clicked="OnNext" HorizontalOptions="Center" WidthRequest="160" />
            <c:ScoreGauge x:Name="Gauge" HorizontalOptions="Center" />
            <c:AutomationBar x:Name="Automation" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
