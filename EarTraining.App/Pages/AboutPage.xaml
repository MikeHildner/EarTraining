<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EarTraining.App.Pages.AboutPage"
             Title="About">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <!-- Header -->
            <Border StrokeShape="RoundRectangle 18" HeightRequest="78" WidthRequest="78"
                    HorizontalOptions="Center" Padding="9" Stroke="Transparent" Margin="0,6,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9B8CEF" Offset="0" />
                        <GradientStop Color="#6A5AE6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Image Source="welcome_ear.png" Aspect="AspectFit" />
            </Border>
            <Label Text="Ear Training" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label x:Name="VersionLabel" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
            <Label Text="Ear-training drills for intervals, triads, progressions, and dictation — randomized and playable in any key, so you train your ears, not your memory."
                   HorizontalTextAlignment="Center" Margin="0,2,0,2" />

            <!-- What's inside -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="9">
                        <Label Text="&#xf03a;" FontFamily="FA" FontSize="15" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" VerticalOptions="Center" />
                        <Label Text="What's inside" Style="{StaticResource Heading}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label FontSize="13.5" Text="• Level 1 · Chapters 1–7 — vocal drills, interval &amp; triad ID, triad recognition, progressions, and dictation." />
                    <Label FontSize="13.5" Text="• Level 2 — major and diatonic triad progressions." />
                    <Label FontSize="13.5" Text="• Not in the Books — Interval &amp; Triad ID, Find the DO, Solfège Syllables, Major-Triad Movements." />
                    <Label FontSize="13.5" Text="• A score gauge and hands-free Automation on every quiz." />
                </VerticalStackLayout>
            </Border>

            <!-- How to use -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="9">
                        <Label Text="&#xf144;" FontFamily="FA" FontSize="15" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" VerticalOptions="Center" />
                        <Label Text="How to use" Style="{StaticResource Heading}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label FontSize="13.5" Text="1.  Pick a chapter from Home or the menu." />
                    <Label FontSize="13.5" Text="2.  Set or hear the DO (tonic); tap New DO for a fresh key." />
                    <Label FontSize="13.5" Text="3.  Play the drill, then tap what you heard." />
                    <Label FontSize="13.5" Text="4.  Watch the score gauge — or tap Automate for hands-free rounds." />
                </VerticalStackLayout>
            </Border>

            <!-- Based on -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="9">
                        <Label Text="&#xf02d;" FontFamily="FA" FontSize="15" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" VerticalOptions="Center" />
                        <Label Text="Based on" Style="{StaticResource Heading}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label FontSize="13.5">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="These exercises extend " />
                                <Span Text="Mark Harrison" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUrl}" CommandParameter="https://www.harrisonmusic.com" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text="&apos;s &quot;Contemporary Eartraining&quot; series (published by Hal Leonard)." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Built with -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="7">
                    <HorizontalStackLayout Spacing="9">
                        <Label Text="&#xf121;" FontFamily="FA" FontSize="15" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" VerticalOptions="Center" />
                        <Label Text="Built with" Style="{StaticResource Heading}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="• Plugin.Maui.Audio (MIT) — audio playback" FontSize="13.5" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenUrl}" CommandParameter="https://github.com/jfversluis/Plugin.Maui.Audio" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="• VexFlow (MIT) — music notation" FontSize="13.5" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenUrl}" CommandParameter="https://www.vexflow.com/" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="• Font Awesome 4.7 (SIL OFL 1.1) — icons" FontSize="13.5" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenUrl}" CommandParameter="https://fontawesome.com/v4/" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="• .NET MAUI (MIT)" FontSize="13.5" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenUrl}" CommandParameter="https://github.com/dotnet/maui" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Button x:Name="LicenseToggle" Text="Open-source licenses" Clicked="OnToggleLicenses"
                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" HorizontalOptions="Start"
                            Padding="0" Margin="0,2,0,0" />
                    <Label x:Name="LicenseText" IsVisible="False" FontSize="12" TextColor="{AppThemeBinding Light=#555555, Dark=#B8B6C2}" />
                </VerticalStackLayout>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="9">
                        <Label Text="&#xf023;" FontFamily="FA" FontSize="15" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" VerticalOptions="Center" />
                        <Label Text="Privacy" Style="{StaticResource Heading}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Works fully offline — no account, no network calls." FontSize="13.5" />
                    <Label Text="No tracking, no analytics, no advertisements." FontSize="13.5" />
                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Button Text="✉ Report an issue by email" Clicked="OnReportEmail" Margin="0,4,0,0" />
            <Button Text="Report an issue on GitHub" Command="{Binding OpenUrl}"
                    CommandParameter="https://github.com/MikeHildner/EarTraining/issues" />
            <Label Text="Opening a GitHub issue needs a free account." FontSize="12" TextColor="Gray"
                   HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Button Text="View source on GitHub" Command="{Binding OpenUrl}"
                    CommandParameter="https://github.com/MikeHildner/EarTraining" Margin="0,4,0,0" />
            <Label Text="Made by Mike Hildner" FontSize="13" TextColor="Gray" HorizontalOptions="Center" Margin="0,6,0,0" />
            <Label Text="This app treats C4 as Middle C (261.63 Hz)."
                   FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center" Margin="0,0,0,8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
