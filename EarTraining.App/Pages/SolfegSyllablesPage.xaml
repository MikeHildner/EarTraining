<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.SolfegSyllablesPage"
             Title="Solfège Syllables">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Solfège Syllables" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="A reference of every syllable from DO to DO. Tap one to hear it relative to the current DO."
                   HorizontalOptions="Center" TextColor="Gray" />
            <c:TonicHeader x:Name="DoHeader" />
            <FlexLayout x:Name="SyllablesLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
