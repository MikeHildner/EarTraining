<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EarTraining.App.Components"
             x:Class="EarTraining.App.Pages.MelodyHarmonizationPage"
             Title="Melody Harmonization">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Melody Harmonization" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Play the note with its chord, then identify the harmonizing triad."
                   HorizontalOptions="Center" TextColor="Gray" />
            <c:InfoNote Text="Identify the harmonizing I, IV, or V triad for each melody note. From p. 59." />
            <c:TonicHeader x:Name="DoHeader" />
            <Button Text="▶ Play chord" Clicked="OnPlay" />
            <Label Text="Which triad harmonized the note?" FontAttributes="Bold" HorizontalOptions="Center" />
            <FlexLayout x:Name="AnswersLayout" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" />
            <Button x:Name="NextButton" Text="↻ New Chord" Clicked="OnNext" HorizontalOptions="Center" WidthRequest="200" />
            <Label x:Name="StatusLabel" HorizontalOptions="Center" FontAttributes="Bold" />
            <c:ScoreGauge x:Name="Gauge" HorizontalOptions="Center" />
            <c:AutomationBar x:Name="Automation" />
            <c:IncludeToggles x:Name="Includes" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
