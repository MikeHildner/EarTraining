<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:EarTraining.App.Pages"
       x:Class="EarTraining.App.AppShell"
       FlyoutBehavior="Flyout"
       Title="Ear Training">

    <FlyoutItem Title="Level 1 · Chapter 1">
        <ShellContent Title="Vocal Drills" ContentTemplate="{DataTemplate pages:VocalDrillsPage}" />
        <ShellContent Title="Resolution ID" ContentTemplate="{DataTemplate pages:ResolutionIdPage}" />
        <ShellContent Title="Pitch ID" ContentTemplate="{DataTemplate pages:PitchIdPage}" />
        <ShellContent Title="Dictation" ContentTemplate="{DataTemplate pages:DictationPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Level 1 · Chapter 2">
        <ShellContent Title="Vocal Drills" ContentTemplate="{DataTemplate pages:VocalDrillsL1C2Page}" />
        <ShellContent Title="Melodic Intervals" ContentTemplate="{DataTemplate pages:MelodicIntervalL1C2Page}" />
        <ShellContent Title="Harmonic Intervals" ContentTemplate="{DataTemplate pages:HarmonicIntervalL1C2Page}" />
    </FlyoutItem>

    <FlyoutItem Title="Other drills">
        <ShellContent Title="Interval ID" ContentTemplate="{DataTemplate pages:IntervalPage}" />
        <ShellContent Title="Triad ID" ContentTemplate="{DataTemplate pages:TriadPage}" />
    </FlyoutItem>

</Shell>
