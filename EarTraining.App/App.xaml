<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EarTraining.App"
             x:Class="EarTraining.App.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Implicit: themed page background + default text color, so every page and uncolored
                 label flips with light/dark automatically (no per-page edits). -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#15131C}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=#E4E2EA}" />
            </Style>

            <!-- Form controls (Settings + the dictation option rows). Explicit theming so they never
                 fall back to platform defaults — the light-mode purples are near-invisible on dark
                 surfaces. Dark accent matches AnswerButton / Theme.Accent (#B7A6FF); Android's native
                 radio/dialog tint gets the same treatment via values-night/colors.xml. -->
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=#E4E2EA}" />
                <Setter Property="TitleColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9AA0AA}" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
                <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light=#E0DCF5, Dark=#383150}" />
                <Setter Property="ThumbColor" Value="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
            </Style>
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
            </Style>

            <!-- Filled action buttons (▶ play / ↻ new). White text on purple; the purple is nudged
                 lighter in dark so white text stays legible. No Disabled bg setter, so the drill pages'
                 programmatic correct/incorrect colors (SeaGreen/IndianRed) aren't clobbered. -->
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#512BD4, Dark=#6C5CE0}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <!-- Outline look for quiz answer buttons (themed accent border/text); they fill green/red on answer. -->
            <Style x:Key="AnswerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#512BD4, Dark=#B7A6FF}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <!-- Themed card (Border) used by About / Progress / Settings sections. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0DCF5, Dark=#383150}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F3FC, Dark=#211E30}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Pinned bottom DO bar on drill pages: holds the TonicHeader so Play DO stays reachable
                 while the answer grid scrolls above it. Top hairline + themed bar bg; bottom padding
                 clears the iOS home indicator / Android nav bar. -->
            <Style x:Key="PinnedDoBar" TargetType="Border">
                <Setter Property="StrokeShape" Value="Rectangle" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0DCF5, Dark=#383150}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F7F5FD, Dark=#1B1825}" />
                <Setter Property="Padding" Value="16,10,16,18" />
            </Style>

            <!-- Themed section heading label. -->
            <Style x:Key="Heading" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#3C3489, Dark=#CFC6F2}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
