@{Html.RenderPartial("~/Views/Shared/RevealModal.cshtml");}

</div>
@section  scripts {
    <script>
        var jsIntervals = [];
        let iterations = 0;
        let maxIterations = 10;

        let delayBeforeProgression = 1000;
        let delayBeforeShowModal = 4500;
        let delayBeforeHideModal = 3500;
        let delayBetweenIterations = delayBeforeProgression + delayBeforeShowModal + delayBeforeHideModal;

        let isDoingAutomation = false;

        var isVibe = document.body.classList.contains('theme-vibe');

        // ── Scoring quiz state (Vibe only) ──
        // The key is re-randomized each drill, so the quiz identifies the progression
        // TYPE (Circle of 5th / 4th / half-step up / down), not the specific inversions.
        var drillCategory = {
            0: 'Circle of 5th', 1: 'Circle of 5th', 2: 'Circle of 5th',
            3: 'Circle of 4th', 4: 'Circle of 4th', 5: 'Circle of 4th',
            6: 'Half-step up', 7: 'Half-step up',
            8: 'Half-step down', 9: 'Half-step down'
        };
        var categoryOrder = ['Circle of 5th', 'Circle of 4th', 'Half-step up', 'Half-step down'];
        var currentAnswer = null;
        var quizAnswered = false;
        var quizCorrect = 0;
        var quizTotal = 0;
        var quizStreak = 0;

        var GAUGE_RADIUS = 52;
        var GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;   // ~326.726

        $(document).ready(function () {
            setAudProgressionSrc();

            $('.cb-include').change(function () {
                setAudProgressionSrc();
                if (isVibe) renderQuizOptions();   // available progression types changed
            });

            $("#audProgression").on("ended", function () {
                if (isDoingAutomation) {
                    setAudProgressionSrc();
                }
            });

            if (isVibe) initQuiz();
        });

        function setAudProgressionSrc() {
            $('#spinner').show();
            var baseSrc = '@Url.Action("Get2ChordProgression", "L2C4", new { doNoteName = ViewBag.Pitch.PitchName })';
            var excluded = getExcluded(null, 0);
            var progressiontype = getRandomInt(0, 9, excluded);
            if (isVibe) { currentAnswer = drillCategory[progressiontype] || null; resetQuizQuestion(); }
            var src = baseSrc + '&progressiontype=' + progressiontype;
            //$('#audProgression').attr('src', src);
            $('#audProgression source').attr('src', src);

            var msg = '';
            var friendlyMessage = 'I\'m a message!';;
            switch (progressiontype) {
                case 0:
                    msg = msg + 'V (2nd) - I (1st)';
                    friendlyMessage = '5';
                    break;
                case 1:
                    msg = msg + 'V (1st) - I (root)';
                    friendlyMessage = '5';
                    break;
                case 2:
                    msg = msg + 'V (root) - I (2nd)';
                    friendlyMessage = '5';
                    break;
                case 3:
                    msg = msg + 'IV (1st) - I (2nd)';
                    friendlyMessage = '4';
                    break;
                case 4:
                    msg = msg + 'IV (root) - I (1st)';
                    friendlyMessage = '4';
                    break;
                case 5:
                    msg = msg + 'IV (2nd) - I (root)';
                    friendlyMessage = '4';
                    break;
                case 6:
                    msg = msg + 'I (root) - bII (root)';
                    friendlyMessage = '1/2U';
                    break;
                case 7:
                    msg = msg + 'I (root) - bII (2nd)';
                    friendlyMessage = '1/2U';
                    break;
                case 8:
                    msg = msg + 'I (root) - VII (root)';
                    friendlyMessage = '1/2D';
                    break;
                case 9:
                    msg = msg + 'I (root) - VII (1st)';
                    friendlyMessage = '1/2D';
                    break;
                default:
                    consoleAndToastr("progressiontype '" + progressiontype + "' is not supported.");
                    break;
            }

            friendlyMessage = '<span class="font-weight-bold">' + friendlyMessage + '</span>';

            //var doInfo = '@ViewBag.Pitch.PitchName - @ViewBag.Pitch.Hertz Hz';
            //var doInfo = '@ViewBag.Pitch.PitchName';
            //changeAllDoNoteNames(doInfo);
            //var progressionTable = buildProgressionTable(doInfo, msg);
            //$('#progression').html(progressionTable);

            getNewDo(doTheChange, msg, friendlyMessage);
        }

        function doTheChange(pitchName, msg, friendlyMessage) {
            changeAllDoNoteNames(pitchName);
            var progressionTable = buildProgressionTable(pitchName, msg, friendlyMessage, true);
            $('#progression').html(progressionTable);
            $('#spinner').fadeOut("slow");
        }

        function automate() {
            var buttonText = $("#btnAutomate").text();
            switch (buttonText) {
                case "Go!":
                    isDoingAutomation = true;
                    iterations = 0;   // start each run fresh (don't carry over from a prior Stop)
                    $("#btnAutomate").text("Stop");
                    playAndShow();
                    var jsInterval = setInterval(playAndShow, delayBetweenIterations);
                    jsIntervals.push(jsInterval);
                    break;

                case "Stop":
                    isDoingAutomation = false;
                    $("#btnAutomate").text("Go!");
                    resetIterationsMessage();
                    clearAllIntervals();
                    break;

                default:
                    alert("'" + buttonText + "' is not supported.");
                    break;
            }
        }

        function playAndShow() {
            iterations += 1;
            if (iterations > maxIterations) {
                $("#btnAutomate").text("Go!");
                resetIterationsMessage();
                iterations = 0;
                clearAllIntervals();
                return;
            }
            else {
                $("#remainingIterations").text("Playing " + iterations + " of " + maxIterations + " iterations.");
            }

            //document.getElementById('doPlayer').play();
            setTimeout(playProgression, delayBeforeProgression);
        }

        function playProgression() {
            //setAudProgressionSrc();
            $('#audProgression').trigger("play");
            setTimeout(showModal, delayBeforeShowModal);
        }

        function showModal() {
            $("#revealModalBody").html($("#progression").html());
            $("#revealModal").modal('show');
            setTimeout(hideModal, delayBeforeHideModal);
        }

        function hideModal() {
            $("#revealModal").modal('hide');
        }

        function resetIterationsMessage() {
            $("#remainingIterations").text("Automation will stop after " + maxIterations + " iterations.");
        }

        function clearAllIntervals() {
            for (var id of this.jsIntervals) {
                clearInterval(id);
            }

            jsIntervals = [];
        }

        // ── Scoring quiz (Vibe only — card lives in .vibe-only div) ──
        function initQuiz() {
            renderQuizOptions();
            $('#quizOptions').on('click', '.quiz-option', function () {
                if (!$(this).prop('disabled')) submitGuess($(this).attr('data-answer'));
            });
            var fill = document.getElementById('gaugeFill');
            if (fill) {
                fill.style.strokeDasharray = GAUGE_CIRCUMFERENCE;
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            }
            updateScoreDisplay();
            resetQuizQuestion();
        }

        // Offer a button only for progression types that have a checked prompt.
        function getPlayableCategories() {
            var present = {};
            for (var t in drillCategory) {
                if ($('#cb-include-' + t).is(':checked')) present[drillCategory[t]] = true;
            }
            return categoryOrder.filter(function (c) { return present[c]; });
        }

        function renderQuizOptions() {
            var opts = getPlayableCategories();
            var html = '';
            for (var i = 0; i < opts.length; i++) {
                html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-answer="' + opts[i] + '">' + opts[i] + '</button>';
            }
            $('#quizOptions').html(html);
        }

        function submitGuess(guess) {
            if (quizAnswered || !currentAnswer) return;
            quizAnswered = true;
            quizTotal += 1;

            var $options = $('.quiz-option');
            $options.prop('disabled', true);

            if (guess === currentAnswer) {
                quizCorrect += 1;
                quizStreak += 1;
                $('#quizFeedback').html('<i class="fa fa-check"></i> Correct!')
                    .removeClass('text-danger').addClass('text-success');
            } else {
                quizStreak = 0;
                $('#quizFeedback').html('<i class="fa fa-times"></i> Not quite — it was ' + currentAnswer + '.')
                    .removeClass('text-success').addClass('text-danger');
                $options.filter('[data-answer="' + guess + '"]').removeClass('btn-outline-primary').addClass('btn-danger');
            }
            $options.filter('[data-answer="' + currentAnswer + '"]').removeClass('btn-outline-primary').addClass('btn-success');
            updateScoreDisplay();
        }

        function resetQuizQuestion() {
            quizAnswered = false;
            $('.quiz-option').prop('disabled', false)
                .removeClass('btn-success btn-danger').addClass('btn-outline-primary');
            $('#quizFeedback').html('').removeClass('text-success text-danger');
        }

        function updateScoreDisplay() {
            $('#quizScore').text('Score: ' + quizCorrect + ' / ' + quizTotal);
            $('#quizStreak').text('Streak: ' + quizStreak);
            updateGauge();
        }

        function gaugeTierFor(pct) {
            if (pct >= 90) return { color: '#c99700', label: 'Quite Good', glow: true };
            if (pct >= 70) return { color: '#28a745', label: 'Very Good',  glow: false };
            if (pct >= 50) return { color: '#fd7e14', label: 'Good Work',  glow: false };
            return             { color: '#dc3545', label: 'Good Start', glow: false };
        }

        function updateGauge() {
            var fill   = document.getElementById('gaugeFill');
            var pctEl  = document.getElementById('gaugePct');
            var tierEl = document.getElementById('gaugeTier');
            if (!fill || !pctEl || !tierEl) return;

            if (quizTotal === 0) {
                pctEl.textContent = '—';
                tierEl.textContent = 'Play a progression';
                tierEl.style.color = '#6c757d';
                fill.style.stroke = '#adb5bd';
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
                fill.classList.remove('gauge-glow');
                return;
            }

            var pct = Math.round((quizCorrect / quizTotal) * 100);
            var tier = gaugeTierFor(pct);
            pctEl.textContent = pct + '%';
            tierEl.textContent = tier.label;
            tierEl.style.color = tier.color;
            fill.style.stroke = tier.color;
            fill.classList.toggle('gauge-glow', tier.glow);

            // Re-animate on every answer, even when pct is unchanged: replay the ring's fill
            // sweep from empty up to the current value, plus a brief scale pop.
            var gauge = document.querySelector('.score-gauge');
            var target = GAUGE_CIRCUMFERENCE * (1 - pct / 100);
            fill.style.transition = 'none';
            fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            if (gauge) gauge.classList.remove('gauge-pulse');
            void (gauge ? gauge.offsetWidth : fill.getBoundingClientRect());
            fill.style.transition = '';
            fill.style.strokeDashoffset = target;
            if (gauge) gauge.classList.add('gauge-pulse');
        }

        function resetScore() {
            quizCorrect = 0;
            quizTotal = 0;
            quizStreak = 0;
            updateScoreDisplay();
            resetQuizQuestion();
        }

    </script>
}

