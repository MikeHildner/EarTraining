</div>
@section  scripts {
    <script>

        var jsIntervals = [];
        var iterations = 0;
        var maxIterations = 10;

        var delayBeforeTriad= 3000;
        var delayBeforeShowModal = 6000;
        var delayBeforeHideModal = 3000;
        var delayBetweenIterations = delayBeforeTriad + delayBeforeShowModal + delayBeforeHideModal;

        var isVibe = document.body.classList.contains('theme-vibe');

        // ── Scoring quiz state (Vibe only) ──
        var triadNames = ['I', 'IV', 'V', 'vi', 'iii', 'ii'];
        var inversionNames = ['root', '1st', '2nd'];
        var currentTriadType = -1;
        var currentInversion = -1;
        var quizAnswered = false;
        var quizCorrect = 0;
        var quizTotal = 0;
        var quizStreak = 0;
        var autoScoring = false;   // true only during a "Score me" automated run

        var GAUGE_RADIUS = 52;
        var GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;   // ~326.726

        $(document).ready(function () {
            setAudioSrc();

            $('.cb-include').change(function () {
                setAudioSrc();
                if (isVibe) renderQuizOptions();   // available triads changed
            });

            resetIterationsMessage();
            if (isVibe) initQuiz();
        });

        // Note we're using the controller method from L1C3 because most of the code was already written.
        function setAudioSrc() {
            $('#spinner').show();
            var audioExSrc = '@Url.Action("GetTriadEx", "L1C3", new { doNoteName = ViewBag.Pitch.PitchName })';

            //var triadtype = getRandomInt(0, 5);
            //var inversion = getRandomInt(0, 2);

            // Get the selected chords.
            var selected = $('.cb-include:checkbox:checked');
            if (selected.length === 0) {
                $('#spinner').fadeOut("slow");
                toastr.warning('Please select at least one triad.', 'No Triads Selected');
                return;
            }

            // Pick a random one.
            var randElement = selected[Math.floor(Math.random() * selected.length)];
            var randId = $(randElement).attr('id');
            console.log('randId: ' + randId);

            // Parse out the triad type and inversion.
            var tag = randId.replace('cb-include-', '');
            var parts = tag.split('-');
            var triadtype = parseInt(parts[0]);
            var inversion = parseInt(parts[1]);

            audioExSrc = audioExSrc + '&triadtype=' + triadtype + '&inversion=' + inversion;;

            $('#audioEx').attr('src', audioExSrc);

            var msg = '';
            switch (triadtype) {
                case 0:
                    msg = msg + 'I ';
                    break;
                case 1:
                    msg = msg + 'IV ';
                    break;
                case 2:
                    msg = msg + 'V ';
                    break;
                case 3:
                    msg = msg + 'vi ';
                    break;
                case 4:
                    msg = msg + 'iii ';
                    break;
                case 5:
                    msg = msg + 'ii ';
                    break;
                default:
                    msg = 'triadType ' + triadtype + ' is not supported.';
                    consoleAndToastr(msg);
            }

            switch (inversion) {
                case 0:
                    msg = msg + '(root)';
                    break;
                case 1:
                    msg = msg + '(1st)';
                    break;
                case 2:
                    msg = msg + '(2nd)';
                    break;
                default:
                    msg = 'inversion ' + inversion + ' is not supported.';
                    consoleAndToastr(msg);

            }

            var doInfo = $('#doSpoiler').text();
            var progressionTable = buildProgressionTable(doInfo, msg);
            $('#triad').html(progressionTable);

            currentTriadType = triadtype;
            currentInversion = inversion;
            if (isVibe) resetQuizQuestion();
            $('#spinner').fadeOut("slow");
    }

        function automate() {
            var buttonText = $("#btnAutomate").text();
            switch (buttonText) {
                case "Go!":
                    autoScoring = isVibe && $('#cbScoreAuto').is(':checked');
                    if (autoScoring) resetScore();   // each scored run starts fresh
                    iterations = 0;   // start each run fresh (don't carry over from a prior Stop)
                    $("#btnAutomate").text("Stop");
                    playAndShow();
                    var jsInterval = setInterval(playAndShow, delayBetweenIterations);
                    jsIntervals.push(jsInterval);
                    break;

                case "Stop":
                    autoScoring = false;
                    $("#btnAutomate").text("Go!");
                    resetIterationsMessage();
                    clearAllIntervals();
                    break;

                default:
                    alert("'" + buttonText + "' is not supported.");
                    break;
            }
        }

        function playAndShow() {
            iterations += 1;
            if (iterations > maxIterations) {
                $("#btnAutomate").text("Go!");
                resetIterationsMessage();
                iterations = 0;
                autoScoring = false;
                clearAllIntervals();
                return;
            }
            else {
                $("#remainingIterations").text("Playing " + iterations + " of " + maxIterations + " iterations.");
            }

            document.getElementById('doPlayer').play();
            setTimeout(playTriad, delayBeforeTriad);
        }

        function playTriad() {
            setAudioSrc();
            $('#audioEx').trigger("play");
            setTimeout(showModal, delayBeforeShowModal);
        }

        function showModal() {
            if (autoScoring && !quizAnswered) markMissed();   // scored run: no answer in time = incorrect
            $("#revealModalBody").html($("#triad").html());
            $("#revealModal").modal('show');
            setTimeout(hideModal, delayBeforeHideModal);
        }

        function hideModal() {
            $("#revealModal").modal('hide');
        }

        function clearAllIntervals() {
            for (var id of this.jsIntervals) {
                clearInterval(id);
            }

            jsIntervals = [];
        }

        function resetIterationsMessage() {
            $("#remainingIterations").text("Automation will stop after " + maxIterations + " iterations.");
        }

        // ── Scoring quiz (Vibe only — card lives in .vibe-only div) ──
        // The Invert Selections button toggles the checkboxes directly (no change event),
        // so refresh the playable quiz options after it runs.
        function invertDrillSelections() {
            invertSelections(setAudioSrc);
            if (isVibe) renderQuizOptions();
        }

        function quizMode() {
            return $('input[name="scoreMode"]:checked').val() || 'triad';
        }

        function answerLabel() {
            return triadNames[currentTriadType] + (quizMode() === 'both' ? ' (' + inversionNames[currentInversion] + ')' : '');
        }

        function correctSelector() {
            return quizMode() === 'both'
                ? '[data-triad="' + currentTriadType + '"][data-inv="' + currentInversion + '"]'
                : '[data-triad="' + currentTriadType + '"]';
        }

        function initQuiz() {
            renderQuizOptions();
            $('#quizOptions').on('click', '.quiz-option', function () {
                if (!$(this).prop('disabled')) {
                    submitGuess(parseInt($(this).attr('data-triad'), 10), parseInt($(this).attr('data-inv'), 10));
                }
            });
            $('input[name="scoreMode"]').on('change', function () {
                renderQuizOptions();
                resetScore();   // modes aren't comparable, so start a fresh tally
            });
            var gaugeFill = document.getElementById('gaugeFill');
            if (gaugeFill) {
                gaugeFill.style.strokeDasharray = GAUGE_CIRCUMFERENCE;
                gaugeFill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            }
            updateScoreDisplay();
            resetQuizQuestion();
        }

        function renderQuizOptions() {
            // Only offer triads/inversions that can actually play (checked in "Include in Drills").
            // In "triad" mode a triad is offered if any of its inversions is included.
            var mode = quizMode();
            var html = '';
            for (var t = 0; t < triadNames.length; t++) {
                if (mode === 'both') {
                    for (var inv = 0; inv < inversionNames.length; inv++) {
                        if (!$('#cb-include-' + t + '-' + inv).is(':checked')) continue;
                        html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-triad="' + t + '" data-inv="' + inv + '">' + triadNames[t] + ' (' + inversionNames[inv] + ')</button>';
                    }
                } else {
                    var anyInv = false;
                    for (var inv2 = 0; inv2 < inversionNames.length; inv2++) {
                        if ($('#cb-include-' + t + '-' + inv2).is(':checked')) { anyInv = true; break; }
                    }
                    if (!anyInv) continue;
                    html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-triad="' + t + '" data-inv="-1">' + triadNames[t] + '</button>';
                }
            }
            $('#quizOptions').html(html);
        }

        function submitGuess(guessTriad, guessInv) {
            if (quizAnswered) return;
            quizAnswered = true;
            quizTotal += 1;

            var $options = $('.quiz-option');
            $options.prop('disabled', true);

            var mode = quizMode();
            var isCorrect = (guessTriad === currentTriadType) && (mode === 'triad' || guessInv === currentInversion);

            if (isCorrect) {
                quizCorrect += 1;
                quizStreak += 1;
                $('#quizFeedback').html('<i class="fa fa-check"></i> Correct!')
                    .removeClass('text-danger').addClass('text-success');
            } else {
                quizStreak = 0;
                $('#quizFeedback').html('<i class="fa fa-times"></i> Not quite — it was ' + answerLabel() + '.')
                    .removeClass('text-success').addClass('text-danger');
                var guessSel = mode === 'both'
                    ? '[data-triad="' + guessTriad + '"][data-inv="' + guessInv + '"]'
                    : '[data-triad="' + guessTriad + '"]';
                $options.filter(guessSel).removeClass('btn-outline-primary').addClass('btn-danger');
            }
            $options.filter(correctSelector()).removeClass('btn-outline-primary').addClass('btn-success');
            updateScoreDisplay();
        }

        function markMissed() {
            quizAnswered = true;
            quizTotal += 1;
            quizStreak = 0;
            $('.quiz-option').prop('disabled', true)
                .filter(correctSelector()).removeClass('btn-outline-primary').addClass('btn-success');
            $('#quizFeedback').html('<i class="fa fa-times"></i> Time\'s up — it was ' + answerLabel() + '.')
                .removeClass('text-success').addClass('text-danger');
            updateScoreDisplay();
        }

        function resetQuizQuestion() {
            quizAnswered = false;
            $('.quiz-option').prop('disabled', false)
                .removeClass('btn-success btn-danger').addClass('btn-outline-primary');
            $('#quizFeedback').html('').removeClass('text-success text-danger');
        }

        function updateScoreDisplay() {
            $('#quizScore').text('Score: ' + quizCorrect + ' / ' + quizTotal);
            $('#quizStreak').text('Streak: ' + quizStreak);
            updateGauge();
        }

        function gaugeTierFor(pct) {
            if (pct >= 90) return { color: '#c99700', label: 'Quite Good', glow: true };
            if (pct >= 70) return { color: '#28a745', label: 'Very Good',  glow: false };
            if (pct >= 50) return { color: '#fd7e14', label: 'Good Work',  glow: false };
            return             { color: '#dc3545', label: 'Good Start', glow: false };
        }

        function updateGauge() {
            var fill   = document.getElementById('gaugeFill');
            var pctEl  = document.getElementById('gaugePct');
            var tierEl = document.getElementById('gaugeTier');
            if (!fill || !pctEl || !tierEl) return;

            if (quizTotal === 0) {
                pctEl.textContent = '—';
                tierEl.textContent = 'Play a triad';
                tierEl.style.color = '#6c757d';
                fill.style.stroke = '#adb5bd';
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
                fill.classList.remove('gauge-glow');
                return;
            }

            var pct = Math.round((quizCorrect / quizTotal) * 100);
            var tier = gaugeTierFor(pct);
            pctEl.textContent = pct + '%';
            tierEl.textContent = tier.label;
            tierEl.style.color = tier.color;
            fill.style.stroke = tier.color;
            fill.classList.toggle('gauge-glow', tier.glow);

            // Re-animate on every answer, even when pct is unchanged: replay the ring's fill
            // sweep from empty up to the current value, plus a brief scale pop.
            var gauge = document.querySelector('.score-gauge');
            var target = GAUGE_CIRCUMFERENCE * (1 - pct / 100);
            fill.style.transition = 'none';
            fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;   // reset ring to empty
            if (gauge) gauge.classList.remove('gauge-pulse');
            void (gauge ? gauge.offsetWidth : fill.getBoundingClientRect());   // one reflow commits the reset
            fill.style.transition = '';                          // restore the CSS 0.7s sweep
            fill.style.strokeDashoffset = target;                // sweep empty -> current value
            if (gauge) gauge.classList.add('gauge-pulse');       // replay the scale pop
        }

        function resetScore() {
            quizCorrect = 0;
            quizTotal = 0;
            quizStreak = 0;
            updateScoreDisplay();
            resetQuizQuestion();
        }

    </script>
}

