@{
    ViewBag.Title = "L1C4 5.3 Melody Harmonization";
}

<h2>Level 1 Chapter 4</h2>
<h5>@ViewBag.Title</h5>

<div class="ai-note">
    <i class="fa fa-magic ai-note-icon"></i>
    <span><strong>Generated by AI:</strong> This exercise page was implemented with AI assistance.</span>
</div>

<div class="card bg-light text-primary">
    <div class="card-body">
        <i class="fa fa-info"></i>
        <span class="pad-left-10">Identify the harmonizing I, IV, or V triad for each melody note. From page 59.</span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 card">
        @{
            Html.RenderPartial("NewDO");
        }
    </div>
    <div class="col-md-6 card">
        <figure>
            <figcaption>Helper - I triad (root)</figcaption>
            <audio controls preload='none'>
                <source src='@Url.Action("GetTriadEx", "L1C3", new { doNoteName = ViewBag.Pitch.PitchName, triadtype = 0, inversion = 0 })' type='audio/mpeg'>
            </audio>
        </figure>
        <figure>
            <figcaption>Helper - IV triad (root)</figcaption>
            <audio controls preload='none'>
                <source src='@Url.Action("GetTriadEx", "L1C3", new { doNoteName = ViewBag.Pitch.PitchName, triadtype = 1, inversion = 0 })' type='audio/mpeg'>
            </audio>
        </figure>
        <figure>
            <figcaption>Helper - V triad (root)</figcaption>
            <audio controls preload='none'>
                <source src='@Url.Action("GetTriadEx", "L1C3", new { doNoteName = ViewBag.Pitch.PitchName, triadtype = 2, inversion = 0 })' type='audio/mpeg'>
            </audio>
        </figure>
    </div>
</div>

<div class="row">
    <div class="col-md-6 card">
        <div>
            <div class="float-left">
                <h4>Drill</h4>
            </div>
            <div class="float-right">
                <span id="spinner" class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                <input type="button" class="btn btn-primary margin-top-5" value="Get a New Chord" onclick="setAudioSrc()" />
            </div>
        </div>

        <figure>
            <figcaption>Press the play button to hear the melody note with its harmonizing triad</figcaption>
            <audio id="audioEx" controls preload='none'>
                <source src='' type='audio/mpeg'>
            </audio>
        </figure>
        <p>Hover over the below to see the answer</p>
        <div class="spoiler" id="melodyHarmony"></div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h4>Reference Prompts</h4>
    </div>
</div>

