@{Html.RenderPartial("~/Views/Shared/RevealModal.cshtml");}

<div class="vibe-only">
    <div class="row">
        <div class="card">
            <div class="card-header bg-warning text-primary">
                <i class="fa fa-gears"></i><label class="margin-left-default">Automation</label>
            </div>
            <div class="card-body">
                <p class="card-text">Automate the drill process for hands-free singing practice — play the DO, play a drill, then reveal it. This respects your "Include in Drills" selections.</p>
                <div class="custom-control custom-checkbox mb-2">
                    <input type="checkbox" class="custom-control-input" id="cbScoreAuto" />
                    <label class="custom-control-label" for="cbScoreAuto">Score me — quiz me on each drill (an unanswered drill counts as incorrect)</label>
                </div>
                <button id="btnAutomate" class="btn btn-warning" onclick="automate();">Go!</button><label class="margin-left-default" id="remainingIterations"></label>
            </div>
        </div>
    </div>
</div>

</div>
@section  scripts {
    <script>
        var isVibe = document.body.classList.contains('theme-vibe');

        // ── Automation state (Vibe only — card lives in .vibe-only div) ──
        var jsIntervals = [];
        var iterations = 0;
        var maxIterations = 10;

        var delayBeforeDrill = 1500;
        var delayBeforeShowModal = 5000;   // passive run: sung phrase → reveal (longer than a bare interval)
        var delayBeforeShowScored = 7500;  // scored run: extra time to answer a full phrase
        var delayBeforeHideModal = 3500;
        var revealDelay = delayBeforeShowModal;
        var delayBetweenIterations = delayBeforeDrill + revealDelay + delayBeforeHideModal;

        // ── Scoring quiz state (Vibe only) ──
        // Each drill type maps to its solfège pattern. Several types share a sequence
        // (and TI TI RE RE DO covers high/low), so the quiz matches on the syllables —
        // the user identifies the pattern they heard, not the interval.
        var drillSyllables = {
            12: 'RE RE FA FA MI', 13: 'MI MI SO SO SO', 14: 'LA LA DO DO DO',
            15: 'TI TI RE RE DO', 16: 'TI TI RE RE DO', 17: 'DO DO LA LA SO',
            18: 'RE RE TI TI DO', 19: 'FA FA RE RE DO', 20: 'SO SO MI MI MI',
            21: 'LA LA DO DO DO', 22: 'TI TI RE RE DO', 23: 'RE RE FA FA MI',
            24: 'MI MI SO SO SO'
        };
        // Unique sequences, in a stable order, used as the quiz buttons.
        var quizSyllableOptions = ['RE RE FA FA MI', 'MI MI SO SO SO', 'LA LA DO DO DO', 'TI TI RE RE DO', 'DO DO LA LA SO', 'RE RE TI TI DO', 'FA FA RE RE DO', 'SO SO MI MI MI'];
        var currentSyllables = null;
        var quizAnswered = false;
        var quizCorrect = 0;
        var quizTotal = 0;
        var quizStreak = 0;
        var autoScoring = false;   // true only during a "Score me" automated run

        var GAUGE_RADIUS = 52;
        var GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;   // ~326.726

        $(document).ready(function () {
            setAudDrill1Src();

            $('input[type=radio][name=intervaltype]').change(function () {
                setAudDrill1Src();
                if (isVibe) renderQuizOptions();   // available patterns changed
            });

            $('.cb-include').change(function () {
                setAudDrill1Src();
                if (isVibe) renderQuizOptions();   // available patterns changed
            });

            if (isVibe) {
                resetIterationsMessage();
                initQuiz();
            }
        });

        function setAudDrill1Src() {
            $('#spinner').show();
            var baseSrc = '@Url.Action("GetMelodicDrillDO", "L1C2", new { doNoteName = ViewBag.Pitch.PitchName })';

            // Get the drills based on what the user has choosen.
            var intervalType = $("input[type=radio][name=intervaltype]:checked").attr('id');

            var minDrill;
            var maxDrill;
            var excluded = getExcluded(null, 0);

            switch (intervalType) {
                case 'min3rds':
                    minDrill = 12;
                    maxDrill = 16;
                    $('#min-3rd-prompts').fadeIn();
                    $('#maj-6th-prompts').fadeOut();
                    break;

                case 'maj6ths':
                    minDrill = 17;
                    maxDrill = 24;
                    $('#min-3rd-prompts').fadeOut();
                    $('#maj-6th-prompts').fadeIn();
                    break;

                case 'both':
                    minDrill = 12;
                    maxDrill = 24;
                    $('#min-3rd-prompts').fadeIn();
                    $('#maj-6th-prompts').fadeIn();
                    break;

                default:
                    var msg = 'intervalType ' + intervalType + ' is not supported';
                    consoleAndToastr(msg);
            }

            var randomInt = getRandomInt(minDrill, maxDrill, excluded);

            var src = baseSrc + '&type=' + randomInt;
            $('#audDrill1').attr('src', src);

            var msg = '';
            switch (randomInt) {
                case 12:
                    msg = msg + 'RE RE FA FA MI (Min 3rd)';
                    break;
                case 13:
                    msg = msg + 'MI MI SO SO SO (Min 3rd)';
                    break;
                case 14:
                    msg = msg + 'LA LA DO DO DO (Min 3rd)';
                    break;
                case 15:
                    msg = msg + 'TI TI RE RE DO (high) (Min 3rd)';
                    break;
                case 16:
                    msg = msg + 'TI TI RE RE DO (low) (Min 3rd)';
                    break;
                case 17:
                    msg = msg + 'DO DO LA LA SO (Maj 6th)';
                    break;
                case 18:
                    msg = msg + 'RE RE TI TI DO (Maj 6th)';
                    break;
                case 19:
                    msg = msg + 'FA FA RE RE DO (Maj 6th)';
                    break;
                case 20:
                    msg = msg + 'SO SO MI MI MI (Maj 6th)';
                    break;
                case 21:
                    msg = msg + 'LA LA DO DO DO (Maj 6th)';
                    break;
                case 22:
                    msg = msg + 'TI TI RE RE DO (Maj 6th)';
                    break;
                case 23:
                    msg = msg + 'RE RE FA FA MI (Maj 6th)';
                    break;
                case 24:
                    msg = msg + 'MI MI SO SO SO (Maj 6th)';
                    break;

                default:
                    var msg2 = 'drillType ' + randomInt + ' is not supported';
                    consoleAndToastr(msg2);
            }

            $('#drill1').text(msg);

            if (isVibe) {
                currentSyllables = drillSyllables[randomInt] || null;
                resetQuizQuestion();
            }
            $('#spinner').fadeOut("slow");
        }

        // ── Automation (Vibe only — card lives in .vibe-only div) ──
        function automate() {
            var buttonText = $("#btnAutomate").text();
            switch (buttonText) {
                case "Go!":
                    autoScoring = isVibe && $('#cbScoreAuto').is(':checked');
                    if (autoScoring) resetScore();   // each scored run starts fresh
                    revealDelay = autoScoring ? delayBeforeShowScored : delayBeforeShowModal;
                    delayBetweenIterations = delayBeforeDrill + revealDelay + delayBeforeHideModal;
                    iterations = 0;   // start each run fresh (don't carry over from a prior Stop)
                    $("#btnAutomate").text("Stop");
                    playAndShow();
                    jsIntervals.push(setInterval(playAndShow, delayBetweenIterations));
                    break;
                case "Stop":
                    autoScoring = false;
                    $("#btnAutomate").text("Go!");
                    resetIterationsMessage();
                    clearAllIntervals();
                    break;
                default:
                    alert("'" + buttonText + "' is not supported.");
                    break;
            }
        }

        function playAndShow() {
            iterations += 1;
            if (iterations > maxIterations) {
                $("#btnAutomate").text("Go!");
                resetIterationsMessage();
                iterations = 0;
                autoScoring = false;
                clearAllIntervals();
                return;
            } else {
                $("#remainingIterations").text("Playing " + iterations + " of " + maxIterations + " iterations.");
            }
            document.getElementById('doPlayer').play();
            setTimeout(playDrill, delayBeforeDrill);
        }

        function playDrill() {
            setAudDrill1Src();
            $('#audDrill1').trigger("play");
            setTimeout(showModal, revealDelay);
        }

        function showModal() {
            if (autoScoring && !quizAnswered) markMissed();   // scored run: no answer in time = incorrect
            $("#revealModalBody").html($("#drill1").html());
            $("#revealModal").modal('show');
            setTimeout(hideModal, delayBeforeHideModal);
        }

        function hideModal() {
            $("#revealModal").modal('hide');
        }

        function clearAllIntervals() {
            for (var id of jsIntervals) {
                clearInterval(id);
            }
            jsIntervals = [];
        }

        function resetIterationsMessage() {
            $("#remainingIterations").text("Automation will stop after " + maxIterations + " iterations.");
        }

        // ── Scoring quiz (Vibe only — card lives in .vibe-only div) ──
        function initQuiz() {
            renderQuizOptions();
            $('#quizOptions').on('click', '.quiz-option', function () {
                if (!$(this).prop('disabled')) {
                    submitGuess($(this).attr('data-syl'));
                }
            });
            var gaugeFill = document.getElementById('gaugeFill');
            if (gaugeFill) {
                gaugeFill.style.strokeDasharray = GAUGE_CIRCUMFERENCE;
                gaugeFill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            }
            updateScoreDisplay();
            resetQuizQuestion();
        }

        // The drills that can actually play depend on the Min 3rd / Maj 6th / Both
        // toggle and the "Include in Drills" checkboxes — only offer those patterns.
        function getPlayableSyllables() {
            var intervalType = $("input[type=radio][name=intervaltype]:checked").attr('id');
            var min = 12, max = 24;
            if (intervalType === 'min3rds') { max = 16; }
            else if (intervalType === 'maj6ths') { min = 17; }
            var available = {};
            for (var t = min; t <= max; t++) {
                if (drillSyllables[t] && $('#cb-include-' + t).is(':checked')) {
                    available[drillSyllables[t]] = true;
                }
            }
            return quizSyllableOptions.filter(function (s) { return available[s]; });
        }

        function renderQuizOptions() {
            var opts = getPlayableSyllables();
            var html = '';
            for (var i = 0; i < opts.length; i++) {
                html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-syl="' + opts[i] + '">' + opts[i] + '</button>';
            }
            $('#quizOptions').html(html);
        }

        function answerLabel() {
            return currentSyllables || '';
        }

        function submitGuess(guess) {
            if (quizAnswered || !currentSyllables) return;
            quizAnswered = true;
            quizTotal += 1;

            var $options = $('.quiz-option');
            $options.prop('disabled', true);

            if (guess === currentSyllables) {
                quizCorrect += 1;
                quizStreak += 1;
                $('#quizFeedback').html('<i class="fa fa-check"></i> Correct!')
                    .removeClass('text-danger').addClass('text-success');
            } else {
                quizStreak = 0;
                $('#quizFeedback').html('<i class="fa fa-times"></i> Not quite — it was ' + answerLabel() + '.')
                    .removeClass('text-success').addClass('text-danger');
                $options.filter('[data-syl="' + guess + '"]').removeClass('btn-outline-primary').addClass('btn-danger');
            }
            $options.filter('[data-syl="' + currentSyllables + '"]').removeClass('btn-outline-primary').addClass('btn-success');
            updateScoreDisplay();
        }

        function markMissed() {
            quizAnswered = true;
            quizTotal += 1;
            quizStreak = 0;
            $('.quiz-option').prop('disabled', true)
                .filter('[data-syl="' + currentSyllables + '"]').removeClass('btn-outline-primary').addClass('btn-success');
            $('#quizFeedback').html('<i class="fa fa-times"></i> Time\'s up — it was ' + answerLabel() + '.')
                .removeClass('text-success').addClass('text-danger');
            updateScoreDisplay();
        }

        function resetQuizQuestion() {
            quizAnswered = false;
            $('.quiz-option').prop('disabled', false)
                .removeClass('btn-success btn-danger').addClass('btn-outline-primary');
            $('#quizFeedback').html('').removeClass('text-success text-danger');
        }

        function updateScoreDisplay() {
            $('#quizScore').text('Score: ' + quizCorrect + ' / ' + quizTotal);
            $('#quizStreak').text('Streak: ' + quizStreak);
            updateGauge();
        }

        function gaugeTierFor(pct) {
            if (pct >= 90) return { color: '#c99700', label: 'Quite Good', glow: true };
            if (pct >= 70) return { color: '#28a745', label: 'Very Good',  glow: false };
            if (pct >= 50) return { color: '#fd7e14', label: 'Good Work',  glow: false };
            return             { color: '#dc3545', label: 'Good Start', glow: false };
        }

        function updateGauge() {
            var fill   = document.getElementById('gaugeFill');
            var pctEl  = document.getElementById('gaugePct');
            var tierEl = document.getElementById('gaugeTier');
            if (!fill || !pctEl || !tierEl) return;

            if (quizTotal === 0) {
                pctEl.textContent = '—';
                tierEl.textContent = 'Play a drill';
                tierEl.style.color = '#6c757d';
                fill.style.stroke = '#adb5bd';
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
                fill.classList.remove('gauge-glow');
                return;
            }

            var pct = Math.round((quizCorrect / quizTotal) * 100);
            var tier = gaugeTierFor(pct);
            pctEl.textContent = pct + '%';
            tierEl.textContent = tier.label;
            tierEl.style.color = tier.color;
            fill.style.stroke = tier.color;
            fill.classList.toggle('gauge-glow', tier.glow);

            // Re-animate on every answer, even when pct is unchanged: replay the ring's fill
            // sweep from empty up to the current value, plus a brief scale pop.
            var gauge = document.querySelector('.score-gauge');
            var target = GAUGE_CIRCUMFERENCE * (1 - pct / 100);
            fill.style.transition = 'none';
            fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;   // reset ring to empty
            if (gauge) gauge.classList.remove('gauge-pulse');
            void (gauge ? gauge.offsetWidth : fill.getBoundingClientRect());   // one reflow commits the reset
            fill.style.transition = '';                          // restore the CSS 0.7s sweep
            fill.style.strokeDashoffset = target;                // sweep empty -> current value
            if (gauge) gauge.classList.add('gauge-pulse');       // replay the scale pop
        }

        function resetScore() {
            quizCorrect = 0;
            quizTotal = 0;
            quizStreak = 0;
            updateScoreDisplay();
            resetQuizQuestion();
        }

    </script>
}
