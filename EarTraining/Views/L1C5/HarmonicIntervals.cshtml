
@{
    ViewBag.Title = "L1C5 5.2 4th/5th Harmonic Interval Identification";
}
<div class="vibe-page">
<h2>Level 1 Chapter 5</h2>
<h5>@ViewBag.Title</h5>

<div class="card bg-light text-primary">
    <div class="card-body">
        <i class="fa fa-info"></i>
        <span class="pad-left-10">These are selected from the harmonic identification questions on pages 96-97.</span>
    </div>
</div>

<div class="row newdo-row">
    <div class="col-md-6 card">
        @{
            Html.RenderPartial("NewDO");
        }
    </div>
</div>

<div class="row toggle-demo" role="group">
    <div class="col-md-6 card">
        Include drills for
        <div class="switch-toggle alert alert-dark">
            <input id="4ths" name="intervaltype" type="radio" checked>
            <label for="4ths" onclick="">4ths</label>

            <input id="5ths" name="intervaltype" type="radio">
            <label for="5ths" onclick="">5ths</label>

            <input id="both" name="intervaltype" type="radio">
            <label for="both" onclick="">Both</label>

            <a class="btn btn-primary"></a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 card">
        <div>
            <div class="float-left">
                <h4>Drill</h4>
            </div>
            <div class="float-right">
                <span id="spinner" class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                <input type="button" class="btn btn-primary margin-top-5" value="Get a New Interval" onclick="setAudDrill1Src()" />
            </div>
        </div>

        <figure>
            <figcaption>Press the play button to hear the interval</figcaption>
            <audio id="audDrill1" controls preload='none'>
                <source src='' type='audio/mpeg'>
            </audio>
        </figure>
        <p>Hover over the below to see the interval</p>
        <div class="spoiler" id="drill1"></div>
    </div>
</div>

<style>
    /* Scoring accuracy gauge (Vibe mode only) — kept in-view so it is always
       served fresh, independent of the CSS bundle's caching. */
    .score-gauge { position: relative; width: 120px; height: 120px; flex: 0 0 auto; }
    .score-gauge-svg { width: 120px; height: 120px; }
    .score-gauge-track { fill: none; stroke: #e9ecef; stroke-width: 12; }
    .score-gauge-fill {
        fill: none;
        stroke: #adb5bd;
        stroke-width: 12;
        stroke-linecap: round;
        stroke-dasharray: 326.726;
        stroke-dashoffset: 326.726;
        transition: stroke-dashoffset 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), stroke 0.4s ease;
    }
    .score-gauge-fill.gauge-glow { filter: drop-shadow(0 0 5px rgba(201, 151, 0, 0.75)); }
    .score-gauge-center {
        position: absolute; top: 0; left: 0; width: 120px; height: 120px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    }
    .score-gauge-pct { font-size: 1.8rem; font-weight: 700; line-height: 1; color: #2d1b69; }
    .score-gauge-tier { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; margin-top: 0.15rem; color: #6c757d; }
    /* Reserve the feedback line's height so the card doesn't jump as Correct / Not-quite show & hide */
    #quizFeedback { min-height: 1.5rem; }
    /* Brief pulse, re-triggered on every answer, so the gauge reacts even when the
       percentage is unchanged (e.g. consecutive correct answers holding at 100%). */
    @@keyframes gauge-pulse {
        0%   { transform: scale(1); }
        30%  { transform: scale(1.07); }
        100% { transform: scale(1); }
    }
    .score-gauge.gauge-pulse { animation: gauge-pulse 0.5s ease-out; }
</style>

<div class="vibe-only">
    <div class="row">
        <div class="card">
            <div class="card-header bg-success text-white">
                <i class="fa fa-bullseye"></i><label class="margin-left-default">Score Yourself</label>
            </div>
            <div class="card-body">
                <p class="card-text">Play the interval above, then click the one you heard.</p>
                <div id="quizOptions"></div>
                <p id="quizFeedback" class="mt-3 mb-2 font-weight-bold"></p>
                <div class="d-flex align-items-center mt-3">
                    <div class="score-gauge">
                        <svg viewBox="0 0 120 120" width="120" height="120" class="score-gauge-svg">
                            <circle class="score-gauge-track" cx="60" cy="60" r="52" fill="none" stroke="#e9ecef" stroke-width="12"></circle>
                            <circle class="score-gauge-fill" id="gaugeFill" cx="60" cy="60" r="52" fill="none" stroke="#adb5bd" stroke-width="12" stroke-linecap="round" transform="rotate(-90 60 60)"></circle>
                        </svg>
                        <div class="score-gauge-center">
                            <span class="score-gauge-pct" id="gaugePct">—</span>
                            <span class="score-gauge-tier" id="gaugeTier">Play an interval</span>
                        </div>
                    </div>
                    <div class="ml-3">
                        <div id="quizScore">Score: 0 / 0</div>
                        <div id="quizStreak" class="text-muted">Streak: 0</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="resetScore();">Reset Score</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

