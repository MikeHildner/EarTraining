<h5>@ViewBag.Title</h5>

<div class="card bg-light text-primary">
    <div class="card-body">
        <i class="fa fa-info"></i>
        <span class="pad-left-10">These are selected from the diatonic triad progression questions on pages 101-102.</span>
    </div>
</div>

<div class="row newdo-row">
