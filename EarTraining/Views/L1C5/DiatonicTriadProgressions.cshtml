            <figcaption>Helper - I (root)</figcaption>
            <audio id="audio" controls preload='none'>
                <source src='@Url.Action("GetTriadEx", "L1C3", new { doNoteName = ViewBag.Pitch.PitchName, triadtype = 0, inversion = 0 })' type='audio/mpeg'>
            </audio>
        </figure>
    </div>
</div>

<style>
    /* Scoring accuracy gauge (Vibe mode only) — kept in-view so it is always
       served fresh, independent of the CSS bundle's caching. */
    .score-gauge { position: relative; width: 120px; height: 120px; flex: 0 0 auto; }
    .score-gauge-svg { width: 120px; height: 120px; }
    .score-gauge-track { fill: none; stroke: #e9ecef; stroke-width: 12; }
    .score-gauge-fill {
        fill: none;
        stroke: #adb5bd;
        stroke-width: 12;
        stroke-linecap: round;
        stroke-dasharray: 326.726;
        stroke-dashoffset: 326.726;
        transition: stroke-dashoffset 0.7s cubic-bezier(0.22, 0.61, 0.36, 1), stroke 0.4s ease;
    }
    .score-gauge-fill.gauge-glow { filter: drop-shadow(0 0 5px rgba(201, 151, 0, 0.75)); }
    .score-gauge-center {
        position: absolute; top: 0; left: 0; width: 120px; height: 120px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    }
    .score-gauge-pct { font-size: 1.8rem; font-weight: 700; line-height: 1; color: #2d1b69; }
    .score-gauge-tier { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; margin-top: 0.15rem; color: #6c757d; }
    /* Reserve the feedback line's height so the card doesn't jump as Correct / Not-quite show & hide */
    .quiz-feedback { min-height: 1.5rem; }
    /* Brief pulse, re-triggered on every answer, so the gauge reacts even when the
       percentage is unchanged (e.g. consecutive correct answers holding at 100%). */
    @@keyframes gauge-pulse {
        0%   { transform: scale(1); }
        30%  { transform: scale(1.07); }
        100% { transform: scale(1); }
    }
    .score-gauge.gauge-pulse { animation: gauge-pulse 0.5s ease-out; }
</style>

