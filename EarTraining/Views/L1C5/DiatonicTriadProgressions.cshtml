@section  scripts {
    <script>
        var isVibe = document.body.classList.contains('theme-vibe');

        var GAUGE_RADIUS = 52;
        var GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;   // ~326.726

        // ── Scoring quiz state (Vibe mode only); one instance per tab ──
        function newQuiz(labels, types, sfx) {
            return { labels: labels, types: types, sfx: sfx, currentAnswer: '', answered: false,
                     correct: 0, total: 0, streak: 0 };
        }
        var quiz2 = newQuiz(['IV (2nd) - I (root)', 'V (1st) - I (root)', 'I (root) - IV (2nd)', 'vi (2nd) - IV (root)', 'V (root) - vi (root)', 'vi (1st) - I (root)', 'IV (root) - V (root)', 'vi (root) - V (root)', 'IV (root) - vi (2nd)'], [0, 1, 3, 10, 11, 12, 13, 14, 15], '2');
        var quiz3 = newQuiz(['IV (2nd) - V (1st) - I (root)', 'I (root) - IV (2nd) - V (1st)', 'IV (2nd) - I (root) - V (1st)', 'I (root) - V (1st) - vi (1st)', 'vi (2nd) - IV (root) - I (1st)', 'I (root) - vi (1st) - V (1st)', 'V (root) - IV (root) - vi (2nd)', 'IV (root) - V (root) - vi (root)', 'vi (1st) - I (2nd) - IV (1st)', 'V (2nd) - vi (2nd) - I (root)'], [4, 6, 9, 16, 17, 18, 19, 20, 21, 22], '3');

        $(document).ready(function () {
            setAudProgression2Src();
            setAudProgression3Src();

            $('.cb-include').change(function () {
                setAudProgression2Src();
                setAudProgression3Src();
                if (isVibe) { renderQuizOptions(quiz2); renderQuizOptions(quiz3); }   // available progressions changed
            });

            if (isVibe) { initQuiz(quiz2); initQuiz(quiz3); }
        });

        function setAudProgression2Src() {
            $('#spinner2').show();
            var baseSrc = '@Url.Action("Get2ChordProgressionEx", "L1C5", new { doNoteName = ViewBag.Pitch.PitchName })';

            var excluded = getExcluded([2, 4, 5, 6, 7, 8, 9], 0);
            var progressiontype = getRandomInt(0, 15, excluded);

            var src = baseSrc + '&progressiontype=' + progressiontype;
            $('#audProgression2').attr('src', src);

            var msg = '';
            switch (progressiontype) {
                case 0:
                    msg = msg + 'IV (2nd) - I (root)';
                    break;
                case 1:
                    msg = msg + 'V (1st) - I (root)';
                    break;
                case 3:
                    msg = msg + 'I (root) - IV (2nd)';
                    break;
                case 10:
                    msg = msg + 'vi (2nd) - IV (root)';
                    break;
                case 11:
                    msg = msg + 'V (root) - vi (root)';
                    break;
                case 12:
                    msg = msg + 'vi (1st) - I (root)';
                    break;
                case 13:
                    msg = msg + 'IV (root) - V (root)';
                    break;
                case 14:
                    msg = msg + 'vi (root) - V (root)';
                    break;
                case 15:
                    msg = msg + 'IV (root) - vi (2nd)';
                    break;
                default:
                    consoleAndToastr('progression type ' + progressiontype + ' is not supported.');
                    break;
            }

            var doInfo = $('#doSpoiler').text();
            var progressionTable = buildProgressionTable(doInfo, msg);
            $('#progression2').html(progressionTable);

            quiz2.currentAnswer = msg;
            if (isVibe) resetQuizQuestion(quiz2);
            $('#spinner2').fadeOut("slow");
        }

        function setAudProgression3Src() {
            $('#spinner3').show();
            var baseSrc = '@Url.Action("Get3ChordProgressionEx", "L1C5", new { doNoteName = ViewBag.Pitch.PitchName })';

            var excluded = getExcluded([5, 7, 8, 10, 11, 12, 13, 14, 15], 0);
            var progressiontype = getRandomInt(4, 22, excluded);

            var src = baseSrc + '&progressiontype=' + progressiontype;
            $('#audProgression3').attr('src', src);

            var msg = '';
            switch (progressiontype) {
                case 4:
                    msg = msg + 'IV (2nd) - V (1st) - I (root)';
                    break;

                case 6:
                    msg = msg + 'I (root) - IV (2nd) - V (1st)';
                    break;

                case 9:
                    msg = msg + 'IV (2nd) - I (root) - V (1st)';
                    break;

                case 16:
                    msg = msg + 'I (root) - V (1st) - vi (1st)';
                    break;

                case 17:
                    msg = msg + 'vi (2nd) - IV (root) - I (1st)';
                    break;

                case 18:
                    msg = msg + 'I (root) - vi (1st) - V (1st)';
                    break;

                case 19:
                    msg = msg + 'V (root) - IV (root) - vi (2nd)';
                    break;

                case 20:
                    msg = msg + 'IV (root) - V (root) - vi (root)';
                    break;

                case 21:
                    msg = msg + 'vi (1st) - I (2nd) - IV (1st)';
                    break;

                case 22:
                    msg = msg + 'V (2nd) - vi (2nd) - I (root)';
                    break;

                default:
                    consoleAndToastr('progression type ' + progressiontype + ' is not supported.');
                    break;
            }

            var doInfo = $('#doSpoiler').text();
            var progressionTable = buildProgressionTable(doInfo, msg);
            $('#progression3').html(progressionTable);

            quiz3.currentAnswer = msg;
            if (isVibe) resetQuizQuestion(quiz3);
            $('#spinner3').fadeOut("slow");
        }

        // ── Scoring quiz (Vibe mode only); each function takes a per-tab quiz `q` ──
        function initQuiz(q) {
            renderQuizOptions(q);
            $('#quizOptions' + q.sfx).on('click', '.quiz-option', function () {
                if (!$(this).prop('disabled')) submitGuess(q, $(this).attr('data-answer'));
            });
            var fill = document.getElementById('gaugeFill' + q.sfx);
            if (fill) {
                fill.style.strokeDasharray = GAUGE_CIRCUMFERENCE;
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            }
            updateScoreDisplay(q);
            resetQuizQuestion(q);
        }

        function renderQuizOptions(q) {
            // Only offer progressions that can actually play (checked in "Include in Drills").
            var html = '';
            for (var i = 0; i < q.labels.length; i++) {
                if (!$('#cb-include-' + q.types[i]).is(':checked')) continue;
                html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-answer="' + q.labels[i] + '">' + q.labels[i] + '</button>';
            }
            $('#quizOptions' + q.sfx).html(html);
        }

        function submitGuess(q, guess) {
            if (q.answered) return;
            q.answered = true;
            q.total += 1;

            var $options = $('#quizOptions' + q.sfx + ' .quiz-option');
            $options.prop('disabled', true);

            if (guess === q.currentAnswer) {
                q.correct += 1;
                q.streak += 1;
                $('#quizFeedback' + q.sfx).html('<i class="fa fa-check"></i> Correct!')
                    .removeClass('text-danger').addClass('text-success');
                $options.filter('[data-answer="' + q.currentAnswer + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-success');
            } else {
                q.streak = 0;
                $('#quizFeedback' + q.sfx).html('<i class="fa fa-times"></i> Not quite — it was ' + q.currentAnswer + '.')
                    .removeClass('text-success').addClass('text-danger');
                $options.filter('[data-answer="' + guess + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-danger');
                $options.filter('[data-answer="' + q.currentAnswer + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-success');
            }
            updateScoreDisplay(q);
        }

        function resetQuizQuestion(q) {
            q.answered = false;
            $('#quizOptions' + q.sfx + ' .quiz-option').prop('disabled', false)
                .removeClass('btn-success btn-danger').addClass('btn-outline-primary');
            $('#quizFeedback' + q.sfx).html('').removeClass('text-success text-danger');
        }

        function updateScoreDisplay(q) {
            $('#quizScore' + q.sfx).text('Score: ' + q.correct + ' / ' + q.total);
            $('#quizStreak' + q.sfx).text('Streak: ' + q.streak);
            updateGauge(q);
        }

        function gaugeTierFor(pct) {
            if (pct >= 90) return { color: '#c99700', label: 'Quite Good', glow: true };
            if (pct >= 70) return { color: '#28a745', label: 'Very Good',  glow: false };
            if (pct >= 50) return { color: '#fd7e14', label: 'Good Work',  glow: false };
            return             { color: '#dc3545', label: 'Good Start', glow: false };
        }

        function updateGauge(q) {
            var fill   = document.getElementById('gaugeFill' + q.sfx);
            var pctEl  = document.getElementById('gaugePct' + q.sfx);
            var tierEl = document.getElementById('gaugeTier' + q.sfx);
            if (!fill || !pctEl || !tierEl) return;

            if (q.total === 0) {
                pctEl.textContent = '—';
                tierEl.textContent = 'Play a progression';
                tierEl.style.color = '#6c757d';
                fill.style.stroke = '#adb5bd';
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
                fill.classList.remove('gauge-glow');
                return;
            }

            var pct = Math.round((q.correct / q.total) * 100);
            var tier = gaugeTierFor(pct);
            pctEl.textContent = pct + '%';
            tierEl.textContent = tier.label;
            tierEl.style.color = tier.color;
            fill.style.stroke = tier.color;
            fill.classList.toggle('gauge-glow', tier.glow);

            // Re-animate on every answer; scope the pulse to this tab's gauge (page has two).
            var gauge = fill.closest('.score-gauge');
            var target = GAUGE_CIRCUMFERENCE * (1 - pct / 100);
            fill.style.transition = 'none';
            fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            if (gauge) gauge.classList.remove('gauge-pulse');
            void (gauge ? gauge.offsetWidth : fill.getBoundingClientRect());
            fill.style.transition = '';
            fill.style.strokeDashoffset = target;
            if (gauge) gauge.classList.add('gauge-pulse');
        }

        function resetScore(q) {
            q.correct = 0;
            q.total = 0;
            q.streak = 0;
            updateScoreDisplay(q);
            resetQuizQuestion(q);
        }
    </script>
}
