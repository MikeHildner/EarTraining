<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Eartraining</title>
    @Styles.Render("~/Content/css")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="theme-vibe">
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top bg-primary">
        <div class="container">
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            @Html.ActionLink("Ear Training", "Index", "Home", new { area = "" }, new { @class = "navbar-brand image-ear" })
            <div class="navbar-collapse collapse" id="navbarSupportedContent">

                <ul class="nav navbar-nav mr-auto">

                    @* ── Level 1 mega-dropdown: all 7 chapters in 2 columns ── *@
                    <li class="nav-item dropdown dropdown-mega">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownL1" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Level 1
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownL1">
                            <div class="mega-columns">

                                @* Left column: Chapters 1–4 *@
                                <div>
                                    <div class="mega-section">
                                        <div class="mega-section-title">Ch 1 — Solfeg</div>
                                        <a href="@Url.Action("SolfegResolutionsDO", "L1C1")" class="dropdown-item">Vocal Drills <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("SolfegResolutionsNoDO", "L1C1")" class="dropdown-item">Resolution Identification <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("PitchIdentification", "L1C1")" class="dropdown-item">Pitch Identification <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        @Html.ActionLink("Dictation / Transcription", "DictationTranscription", "L1C1", null, new { @class = "dropdown-item" })
                                    </div>
                                    <div class="mega-section">
                                        <div class="mega-section-title">Ch 2 — Maj 3rd &amp; Min 6th</div>
                                        <a href="@Url.Action("VocalDrills", "L1C2")" class="dropdown-item">Vocal Drills <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("MelodicMaj3rdMin6thNoDO", "L1C2")" class="dropdown-item">Melodic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("HarmonicMaj3rdMin6th", "L1C2")" class="dropdown-item">Harmonic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        @Html.ActionLink("Dictation / Transcription", "DictationTranscription", "L1C2", null, new { @class = "dropdown-item" })
                                    </div>
                                    <div class="mega-section">
                                        <div class="mega-section-title">Ch 3 — Min 3rd &amp; Maj 6th</div>
                                        <a href="@Url.Action("VocalDrills", "L1C3")" class="dropdown-item">Vocal Drills <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("MelodicMin3rdMaj6thNoDO", "L1C3")" class="dropdown-item">Melodic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("HarmonicMin3rdMaj6th", "L1C3")" class="dropdown-item">Harmonic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("Index", "L1C3")" class="dropdown-item">I IV V Diatonic Triad Recognition <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                    </div>
                                    <div class="mega-section">
                                        <div class="mega-section-title">Ch 4 — I IV V Triads</div>
                                        <a href="@Url.Action("Index", "L1C4")" class="dropdown-item">2 and 3 Chord Progressions <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("MelodyHarmonization", "L1C4")" class="dropdown-item">Melody Harmonization <span class="ai-badge"><i class="fa fa-magic"></i> AI</span></a>
                                    </div>
                                </div>

                                @* Right column: Chapters 5–7 *@
                                <div>
                                    <div class="mega-section">
                                        <div class="mega-section-title">Ch 5 — Diatonic 4th &amp; 5th</div>
                                        @Html.ActionLink("Vocal Drills", "VocalDrills", "L1C5", null, new { @class = "dropdown-item" })
                                        <a href="@Url.Action("MelodicIntervals", "L1C5")" class="dropdown-item">Melodic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("HarmonicIntervals", "L1C5")" class="dropdown-item">Harmonic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("DiatonicTriadRecognition", "L1C5")" class="dropdown-item">I IV V vi Diatonic Triad Recognition <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        @Html.ActionLink("2 and 3 Chord Progressions", "DiatonicTriadProgressions", "L1C5", null, new { @class = "dropdown-item" })
                                    </div>
                                    <div class="mega-section">
                                        <div class="mega-section-title">Ch 6 — Maj 2nd &amp; Min 7th</div>
                                        @Html.ActionLink("Vocal Drills", "VocalDrills", "L1C6", null, new { @class = "dropdown-item" })
                                        <a href="@Url.Action("MelodicIntervals", "L1C6")" class="dropdown-item">Melodic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("HarmonicIntervals", "L1C6")" class="dropdown-item">Harmonic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("DiatonicTriadRecognition", "L1C6")" class="dropdown-item">I IV V vi iii Diatonic Triad Recognition <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        @Html.ActionLink("2 and 3 Chord Progressions", "DiatonicTriadProgressions", "L1C6", null, new { @class = "dropdown-item" })
                                    </div>
                                    <div class="mega-section">
                                        <div class="mega-section-title">Ch 7 — Min 2nd &amp; Maj 7th</div>
                                        @Html.ActionLink("Vocal Drills", "VocalDrills", "L1C7", null, new { @class = "dropdown-item" })
                                        <a href="@Url.Action("MelodicIntervals", "L1C7")" class="dropdown-item">Melodic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("HarmonicIntervals", "L1C7")" class="dropdown-item">Harmonic Interval ID <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        <a href="@Url.Action("DiatonicTriadRecognition", "L1C7")" class="dropdown-item">I IV V vi iii ii Diatonic Triad Recognition <span class="ai-badge"><i class="fa fa-magic"></i> AI</span> <i class="fa fa-bullseye text-success ml-1" title="Supports scoring"></i></a>
                                        @Html.ActionLink("2 and 3 Chord Progressions", "DiatonicTriadProgressions", "L1C7", null, new { @class = "dropdown-item" })
                                    </div>
                                </div>

                            </div>
                        </div>
                    </li>

                    @* ── Level 2: C4 + C5 combined ── *@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownL2" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Level 2
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownL2">
                            <div class="dropdown-header">Ch 4 — Major Triad Progressions</div>
                            @Html.ActionLink("Circle of 5ths/4ths and ½ Step (pairs)", "MajorTriadProgressions2", "L2C4", null, new { @class = "dropdown-item" })
                            @Html.ActionLink("Circle of 5ths/4ths and ½ Step (3 chords)", "MajorTriadProgressions3", "L2C4", null, new { @class = "dropdown-item" })
                            <div class="dropdown-divider"></div>
                            <div class="dropdown-header">Ch 5 — Diatonic Triad Progressions</div>
                            @Html.ActionLink("Diatonic Triad Progressions (4 chords)", "DiatonicTriadProgressions4", "L2C5", null, new { @class = "dropdown-item" })
                        </div>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownOther" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Other
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownOther">
                            @Html.ActionLink("Find the DO", "Index", "DO", null, new { @class = "dropdown-item" })
                            @Html.ActionLink("All Solfeg Syllables", "Index", "Solfeg", null, new { @class = "dropdown-item" })
                            <a href="@Url.Action("Ratios", "Experimental")" class="dropdown-item">Ratios <span class="ai-badge"><i class="fa fa-magic"></i> AI</span></a>
                        </div>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownExperimental" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Experimental
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownExperimental">
                            @Html.ActionLink("L2 Major Triad Progressions", "MajorTriadProgressions", "L2", null, new { @class = "dropdown-item" })
                            <div class="dropdown-divider"></div>
                            @Html.ActionLink("L1C3 Dictation / Transcription", "DictationTranscription", "L1C3", null, new { @class = "dropdown-item" })
                            <div class="dropdown-divider"></div>
                            @Html.ActionLink("Phrases per Form", "PhrasesPerForm", "Experimental", null, new { @class = "dropdown-item" })
                        </div>
                    </li>

                    <li class="nav-item">@Html.ActionLink("About", "About", "Home", null, new { @class = "nav-link" })</li>
                </ul>
                <span class="navbar-text ml-3 small">
                    <a href="#" onclick="switchToHuman(); return false;" class="text-white-50">Human</a>
                    <span class="text-white-50 mx-1">|</span>
                    <strong class="text-white">Vibe</strong>
                </span>
            </div>
        </div>
    </nav>


    <div class="container body-content">
        @RenderBody()

        @if (ViewBag.ShowPlayDoTriad == true)
        {
            <div class="float-button-2 bg-primary">
                <audio id="triadPlayer" preload='none'>
                    <source src='@Url.Action("GetTriadEx", "L1C3", new { doNoteName = ViewBag.Pitch.PitchName, triadtype = 0, inversion = 0 })' type='audio/mpeg'>
                </audio>
                <div>
                    <img class="my-float-2" src='@Url.Content("~/Content/Images/chord-white.png")' onclick="document.getElementById('triadPlayer').play()" title="Play the DO triad (root)" />
                </div>
            </div>
        }

        @if (ViewBag.ShowDo == true)
        {
            <div class="float-button-1 bg-primary">
                <audio id="doPlayer" preload='none'>
                    <source src='@Url.Action("GetDOEx", "DO", new { doNoteName = ViewBag.Pitch.PitchName })' type='audio/mpeg'>
                </audio>
                <div>
                    <img class="my-float-1" src='@Url.Content("~/Content/Images/quarter-note-white.png")' onclick="document.getElementById('doPlayer').play()" title="Play the DO" />
                </div>
            </div>
        }

        <hr />

        <footer>

            <div class="card z-index-back">
                <div class="card-header small bg-light"><i class="fa fa-lock"></i><label class="margin-left-default">Privacy information</label></div>
                <div class="card-body">
                    <ul class="small">
                        <li>We don't use cookies</li>
                        <li>We don't collect, record or share any personal information</li>
                    </ul>
                </div>
            </div>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/site")
    @RenderSection("scripts", required: false)

    <script>
        var rootPath = '@Url.Content("~/")';

        $(document).ready(function () {
            deleteOldFiles();

            $(window).resize(function () {
                setBodyMargin();
            });

            setBodyMargin();
        });

        function deleteOldFiles() {
            $.ajax({
                url: '@Url.Content("~/")' + 'base/DeleteOldFiles'
            });
        }

        function switchToHuman() {
            var appPath = rootPath.replace(/\/$/, ''); // '/eartraining' in prod, '' locally
            var path = window.location.pathname;
            var humanPrefix = (appPath + '/Human').toLowerCase();
            if (path.toLowerCase() === humanPrefix || path.toLowerCase().indexOf(humanPrefix + '/') === 0) return;
            var relative = path.toLowerCase().indexOf(appPath.toLowerCase()) === 0 ? path.slice(appPath.length) : path;
            window.location.href = appPath + '/Human' + relative + window.location.search;
        }

        function setBodyMargin() {
            var heightSlider = $('.navbar').height();
            $('.body-content').css({ marginTop: heightSlider + 0 + 'px' });
        }

    </script>
</body>
</html>
