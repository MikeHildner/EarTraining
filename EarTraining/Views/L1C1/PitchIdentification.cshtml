@{Html.RenderPartial("~/Views/Shared/RevealModal.cshtml");}

</div>
@section  scripts {
    <script>
        var isVibe = document.body.classList.contains('theme-vibe');

        var jsIntervals = [];
        var iterations = 0;
        var maxIterations = 10;

        var delayBeforeNote = 3000;
        var delayBeforeShowModal = 3000;   // passive run: delay from note playing to answer reveal
        var delayBeforeShowScored = 6000;  // scored run: longer reveal delay = more time to answer
        var delayBeforeHideModal = 3000;
        var revealDelay = delayBeforeShowModal;   // effective note->reveal delay for the current run
        var delayBetweenIterations = delayBeforeNote + revealDelay + delayBeforeHideModal;

        // ── Scoring quiz state (Vibe mode only) ──
        var noteLabels = ['DO', 'RE', 'MI', 'FA', 'SO', 'LA', 'TI'];
        // Each practice note's drill type maps to its syllable; DO (0 & 12) and TI (-1 & 11)
        // each appear twice, so the quiz dedupes by label when tracking "Include in Drills".
        var noteTypeLabels = { '-1': 'TI', '0': 'DO', '2': 'RE', '4': 'MI', '5': 'FA', '7': 'SO', '9': 'LA', '11': 'TI', '12': 'DO' };
        var currentAnswerLabel = '';
        var quizAnswered = false;
        var quizCorrect = 0;
        var quizTotal = 0;
        var quizStreak = 0;
        var autoScoring = false;   // true only during a "Score me" automated run

        var GAUGE_RADIUS = 52;
        var GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;   // ~326.726

        $(document).ready(function () {
            setAudNoteSrc();
            $('.cb-include').change(function () {
                setAudNoteSrc();
                if (isVibe) renderQuizOptions();   // available syllables changed
            });

            resetIterationsMessage();
            if (isVibe) initQuiz();
        });

        function setAudNoteSrc() {
            $('#spinner').show();
            var baseSrc = '@Url.Action("GetNoteEx", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName })';
            var excluded = [1, 3, 6, 8, 10];
            excluded = getExcluded(excluded, 0);
            var randomInt = getRandomInt(-1, 12, excluded);
            var src = baseSrc + '&type=' + randomInt;
            $('#audNote').attr('src', src);

            var msg = '';
            switch (randomInt) {
                case -1:
                    msg = msg + 'TI';
                    break;
                case 0:
                    msg = msg + 'DO';
                    break;
                case 2:
                    msg = msg + 'RE';
                    break;
                case 4:
                    msg = msg + 'MI';
                    break;
                case 5:
                    msg = msg + 'FA';
                    break;
                case 7:
                    msg = msg + 'SO';
                    break;
                case 9:
                    msg = msg + 'LA';
                    break;
                case 11:
                    msg = msg + 'TI';
                    break;
                case 12:
                    msg = msg + 'DO';
                    break;
                default:
                    consoleAndToastr('Note type \'' + randomInt + '\' is not supported.');
            }

            $('#note').text(msg);
            $('#spinner').fadeOut("slow");

            currentAnswerLabel = msg;
            if (isVibe) resetQuizQuestion();
        }

        function automate() {
            var buttonText = $("#btnAutomate").text();
            switch (buttonText) {
                case "Go!":
                    autoScoring = isVibe && $('#cbScoreAuto').is(':checked');
                    if (autoScoring) resetScore();   // each scored run starts fresh
                    revealDelay = autoScoring ? delayBeforeShowScored : delayBeforeShowModal;
                    delayBetweenIterations = delayBeforeNote + revealDelay + delayBeforeHideModal;
                    iterations = 0;   // start each run fresh (don't carry over from a prior Stop)
                    $("#btnAutomate").text("Stop");
                    playAndShow();
                    var jsInterval = setInterval(playAndShow, delayBetweenIterations);
                    jsIntervals.push(jsInterval);
                    break;

                case "Stop":
                    autoScoring = false;
                    $("#btnAutomate").text("Go!");
                    resetIterationsMessage();
                    clearAllIntervals();
                    break;

                default:
                    alert("'" + buttonText + "' is not supported.");
                    break;
            }
        }

        function playAndShow() {
            iterations += 1;
            if (iterations > maxIterations) {
                $("#btnAutomate").text("Go!");
                resetIterationsMessage();
                iterations = 0;
                autoScoring = false;
                clearAllIntervals();
                return;
            }
            else {
                $("#remainingIterations").text("Playing " + iterations + " of " + maxIterations + " iterations.");
            }

            document.getElementById('doPlayer').play();
            setTimeout(playNote, delayBeforeNote);
        }

        function playNote() {
            setAudNoteSrc();
            $('#audNote').trigger("play");
            setTimeout(showModal, revealDelay);
        }

        function showModal() {
            // Scored automation: a note not answered before the reveal counts as incorrect.
            if (autoScoring && !quizAnswered) {
                quizAnswered = true;
                quizTotal += 1;
                quizStreak = 0;
                $('.quiz-option').prop('disabled', true)
                    .filter('[data-answer="' + currentAnswerLabel + '"]').removeClass('btn-outline-primary').addClass('btn-success');
                $('#quizFeedback').html('<i class="fa fa-times"></i> Time\'s up — the note was "' + currentAnswerLabel + '".')
                    .removeClass('text-success').addClass('text-danger');
                updateScoreDisplay();
            }
            $("#revealModalBody").html($("#note").html());
            $("#revealModal").modal('show');
            setTimeout(hideModal, delayBeforeHideModal);
        }

        function hideModal() {
            $("#revealModal").modal('hide');
        }


        function clearAllIntervals() {
            for (var id of this.jsIntervals) {
                clearInterval(id);
            }

            jsIntervals = [];
        }

        function resetIterationsMessage() {
            $("#remainingIterations").text("Automation will stop after " + maxIterations + " iterations.");
        }

        // ── Scoring quiz (Vibe mode only — card lives in .vibe-only div) ────────
        function initQuiz() {
            renderQuizOptions();
            $('#quizOptions').on('click', '.quiz-option', function () {
                if (!$(this).prop('disabled')) {
                    submitGuess($(this).attr('data-answer'));
                }
            });
            var gaugeFill = document.getElementById('gaugeFill');
            if (gaugeFill) {
                gaugeFill.style.strokeDasharray = GAUGE_CIRCUMFERENCE;
                gaugeFill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            }
            updateScoreDisplay();
            resetQuizQuestion();
        }

        function renderQuizOptions() {
            // Only offer syllables whose note can actually play (checked in "Include in Drills"),
            // deduped by label since DO and TI each appear on two practice notes.
            var available = {};
            for (var type in noteTypeLabels) {
                if ($('#cb-include-' + type).is(':checked')) available[noteTypeLabels[type]] = true;
            }
            var html = '';
            for (var i = 0; i < noteLabels.length; i++) {
                if (!available[noteLabels[i]]) continue;
                html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-answer="' + noteLabels[i] + '">' + noteLabels[i] + '</button>';
            }
            $('#quizOptions').html(html);
        }

        function submitGuess(guess) {
            if (quizAnswered) return;
            quizAnswered = true;
            quizTotal += 1;

            var $options = $('.quiz-option');
            $options.prop('disabled', true);

            if (guess === currentAnswerLabel) {
                quizCorrect += 1;
                quizStreak += 1;
                $('#quizFeedback').html('<i class="fa fa-check"></i> Correct!')
                    .removeClass('text-danger').addClass('text-success');
                $options.filter('[data-answer="' + currentAnswerLabel + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-success');
            } else {
                quizStreak = 0;
                $('#quizFeedback').html('<i class="fa fa-times"></i> Not quite — the note was "' + currentAnswerLabel + '".')
                    .removeClass('text-success').addClass('text-danger');
                $options.filter('[data-answer="' + guess + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-danger');
                $options.filter('[data-answer="' + currentAnswerLabel + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-success');
            }
            updateScoreDisplay();
        }

        function resetQuizQuestion() {
            quizAnswered = false;
            $('.quiz-option').prop('disabled', false)
                .removeClass('btn-success btn-danger').addClass('btn-outline-primary');
            $('#quizFeedback').html('').removeClass('text-success text-danger');
        }

        function updateScoreDisplay() {
            $('#quizScore').text('Score: ' + quizCorrect + ' / ' + quizTotal);
            $('#quizStreak').text('Streak: ' + quizStreak);
            updateGauge();
        }

        function gaugeTierFor(pct) {
            if (pct >= 90) return { color: '#c99700', label: 'Quite Good', glow: true };
            if (pct >= 70) return { color: '#28a745', label: 'Very Good',  glow: false };
            if (pct >= 50) return { color: '#fd7e14', label: 'Good Work',  glow: false };
            return             { color: '#dc3545', label: 'Good Start', glow: false };
        }

        function updateGauge() {
            var fill   = document.getElementById('gaugeFill');
            var pctEl  = document.getElementById('gaugePct');
            var tierEl = document.getElementById('gaugeTier');
            if (!fill || !pctEl || !tierEl) return;

            if (quizTotal === 0) {
                pctEl.textContent = '—';
                tierEl.textContent = 'Play a note';
                tierEl.style.color = '#6c757d';
                fill.style.stroke = '#adb5bd';
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
                fill.classList.remove('gauge-glow');
                return;
            }

            var pct = Math.round((quizCorrect / quizTotal) * 100);
            var tier = gaugeTierFor(pct);
            pctEl.textContent = pct + '%';
            tierEl.textContent = tier.label;
            tierEl.style.color = tier.color;
            fill.style.stroke = tier.color;
            fill.classList.toggle('gauge-glow', tier.glow);

            // Re-animate on every answer, even when pct is unchanged: replay the ring's fill
            // sweep from empty up to the current value, plus a brief scale pop.
            var gauge = document.querySelector('.score-gauge');
            var target = GAUGE_CIRCUMFERENCE * (1 - pct / 100);
            fill.style.transition = 'none';
            fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;   // reset ring to empty
            if (gauge) gauge.classList.remove('gauge-pulse');
            void (gauge ? gauge.offsetWidth : fill.getBoundingClientRect());   // one reflow commits the reset
            fill.style.transition = '';                          // restore the CSS 0.7s sweep
            fill.style.strokeDashoffset = target;                // sweep empty -> current value
            if (gauge) gauge.classList.add('gauge-pulse');       // replay the scale pop
        }

        function resetScore() {
            quizCorrect = 0;
            quizTotal = 0;
            quizStreak = 0;
            updateScoreDisplay();
            resetQuizQuestion();
        }

    </script>
}
