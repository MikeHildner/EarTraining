@{
    ViewBag.Title = "L1C1 3.1 - Solfeg Resolutions Vocal Drills";
}

<h2>Level 1 Chapter 1</h2>
<h5>@ViewBag.Title</h5>

<div class="ai-note vibe-only">
    <i class="fa fa-magic ai-note-icon"></i>
    <span><strong>Generated by AI:</strong> The Automation feature on this page was implemented with AI assistance.</span>
</div>

<div class="card bg-light text-primary">
    <div class="card-body">
        <i class="fa fa-info"></i>
        <span class="pad-left-10">These are selected from the vocal drills on pages 9-10.</span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 card">
        @{
            Html.RenderPartial("NewDO");
        }
    </div>
</div>

<div class="row">
    <div class="col-md-6 card">
        <div>
            <div class="float-left">
                <h4>Drill</h4>
            </div>
            <div class="float-right">
                <span id="spinner" class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                <input type="button" class="btn btn-primary margin-top-5" value="Get a New Drill" onclick="setAudResolutionSrc()" />
            </div>
        </div>
        <figure>
            <figcaption>Press the play button to hear the drill</figcaption>
            <audio id="audResolution" controls preload='none'>
                <source src='@Url.Action("GetResolutionDO", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName })' type='audio/mpeg'>
            </audio>
        </figure>
        <p>Hover over the below to reveal the drill</p>
        <div class="spoiler" id="resolution"></div>
    </div>
</div>

<h4>Practice Drills</h4>

<div class="row">
    <div class="col-md-4 card">
        <figure>
            <figcaption>
                <div class="float-left">DO DO RE DO</div>
                <div class="float-right custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input cb-include" id="cb-include-0" checked />
                    <label class="custom-control-label small" for="cb-include-0">Include in Drills</label>
                </div>
            </figcaption>
            <div class="clearfix"></div>
            <audio controls preload='none'>
                <source src='@Url.Action("GetResolutionDO", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName, type = 0 })' type='audio/mpeg'>
            </audio>
        </figure>
    </div>
    <div class="col-md-4 card">
        <figure>
            <figcaption>
                <div class="float-left">DO DO FA MI</div>
                <div class="float-right custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input cb-include" id="cb-include-1" checked />
                    <label class="custom-control-label small" for="cb-include-1">Include in Drills</label>
                </div>
            </figcaption>
            <div class="clearfix"></div>
            <audio controls preload='none'>
                <source src='@Url.Action("GetResolutionDO", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName, type = 1 })' type='audio/mpeg'>
            </audio>
        </figure>
    </div>
    <div class="col-md-4 card">
        <figure>
            <figcaption>
                <div class="float-left">DO DO LA SO</div>
                <div class="float-right custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input cb-include" id="cb-include-2" checked />
                    <label class="custom-control-label small" for="cb-include-2">Include in Drills</label>
                </div>
            </figcaption>
            <div class="clearfix"></div>
            <audio controls preload='none'>
                <source src='@Url.Action("GetResolutionDO", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName, type = 2 })' type='audio/mpeg'>
            </audio>
        </figure>
    </div>
    <div class="col-md-4 card">
        <figure>
            <figcaption>
                <div class="float-left">DO DO (high)TI DO</div>
                <div class="float-right custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input cb-include" id="cb-include-3" checked />
                    <label class="custom-control-label small" for="cb-include-3">Include in Drills</label>
                </div>
            </figcaption>
            <div class="clearfix"></div>
            <audio controls preload='none'>
                <source src='@Url.Action("GetResolutionDO", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName, type = 3 })' type='audio/mpeg'>
            </audio>
        </figure>
    </div>
    <div class="col-md-4 card">
        <figure>
            <figcaption>
                <div class="float-left">DO DO (low)TI DO</div>
                <div class="float-right custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input cb-include" id="cb-include-4" checked />
                    <label class="custom-control-label small" for="cb-include-4">Include in Drills</label>
                </div>
            </figcaption>
            <div class="clearfix"></div>
            <audio controls preload='none'>
                <source src='@Url.Action("GetResolutionDO", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName, type = 4 })' type='audio/mpeg'>
            </audio>
        </figure>
    </div>
</div>

@{Html.RenderPartial("~/Views/Shared/RevealModal.cshtml");}

<div class="vibe-only">
    <div class="row">
        <div class="card">
            <div class="card-header bg-warning text-primary">
                <i class="fa fa-gears"></i><label class="margin-left-default">Automation</label>
            </div>
            <div class="card-body">
                <p class="card-text">Automate the drill process. This respects your "Include in Drills" selections.</p>
                <button id="btnAutomate" class="btn btn-warning" onclick="automate();">Go!</button><label class="margin-left-default" id="remainingIterations"></label>
            </div>
        </div>
    </div>
</div>

@section  scripts {
    <script>
        var isVibe = document.body.classList.contains('theme-vibe');

        var jsIntervals = [];
        var iterations = 0;
        var maxIterations = 10;

        var delayBeforeDrill       = 1500;
        var delayBeforeShowModal   = 4000;
        var delayBeforeHideModal   = 3500;
        var delayBetweenIterations = delayBeforeDrill + delayBeforeShowModal + delayBeforeHideModal;

        $(document).ready(function () {
            setAudResolutionSrc();
            $('.cb-include').change(function () {
                setAudResolutionSrc();
            });
            if (isVibe) resetIterationsMessage();
        });

        function setAudResolutionSrc() {
            $('#spinner').show();
            var baseSrc = '@Url.Action("GetResolutionDO", "L1C1", new { doNoteName = ViewBag.Pitch.PitchName })';
            var excluded = getExcluded(null, 0);
            var randomInt = getRandomInt(0, 4, excluded);
            var src = baseSrc + '&type=' + randomInt;
            $('#audResolution').attr('src', src);

            var msg = '';
            switch (randomInt) {
                case 0: msg = 'DO DO RE DO';        break;
                case 1: msg = 'DO DO FA MI';        break;
                case 2: msg = 'DO DO LA SO';        break;
                case 3: msg = 'DO DO (high)TI DO'; break;
                case 4: msg = 'DO DO (low)TI DO';  break;
                default: consoleAndToastr('Resolution type \'' + randomInt + '\' is not supported.');
            }

            $('#resolution').text(msg);
            $('#spinner').fadeOut("slow");
        }

        // ── Automation (Vibe mode only — button lives in .vibe-only div) ────────
        function automate() {
            var buttonText = $("#btnAutomate").text();
            switch (buttonText) {
                case "Go!":
                    $("#btnAutomate").text("Stop");
                    playAndShow();
                    var jsInterval = setInterval(playAndShow, delayBetweenIterations);
                    jsIntervals.push(jsInterval);
                    break;
                case "Stop":
                    $("#btnAutomate").text("Go!");
                    resetIterationsMessage();
                    clearAllIntervals();
                    break;
                default:
                    alert("'" + buttonText + "' is not supported.");
                    break;
            }
        }

        function playAndShow() {
            iterations += 1;
            if (iterations > maxIterations) {
                $("#btnAutomate").text("Go!");
                resetIterationsMessage();
                iterations = 0;
                clearAllIntervals();
                return;
            } else {
                $("#remainingIterations").text("Playing " + iterations + " of " + maxIterations + " iterations.");
            }
            document.getElementById('doPlayer').play();
            setTimeout(playDrill, delayBeforeDrill);
        }

        function playDrill() {
            setAudResolutionSrc();
            $('#audResolution').trigger("play");
            setTimeout(showModal, delayBeforeShowModal);
        }

        function showModal() {
            $("#revealModalBody").html($("#resolution").html());
            $("#revealModal").modal('show');
            setTimeout(hideModal, delayBeforeHideModal);
        }

        function hideModal() {
            $("#revealModal").modal('hide');
        }

        function clearAllIntervals() {
            for (var id of jsIntervals) {
                clearInterval(id);
            }
            jsIntervals = [];
        }

        function resetIterationsMessage() {
            $("#remainingIterations").text("Automation will stop after " + maxIterations + " iterations.");
        }

    </script>
}
