<div class="row">
    <div class="card">
        <div class="card-header bg-warning text-primary">
            <i class="fa fa-gears"></i><label class="margin-left-default">Automation</label>
        </div>
        <div class="card-body">
            <p class="card-text">Automate the drill process. This respects your "Include in Drills" selections.</p>
            <div class="custom-control custom-checkbox mb-2 vibe-only">
                <input type="checkbox" class="custom-control-input" id="cbScoreAuto" />
                <label class="custom-control-label" for="cbScoreAuto">Score me — quiz me on each interval (an unanswered one counts as incorrect)</label>
            </div>
            <button id="btnAutomate" class="btn btn-warning" onclick="automate();">Go!</button><label class="margin-left-default" id="remainingIterations"></label>
        </div>
    </div>
</div>

@{Html.RenderPartial("~/Views/Shared/RevealModal.cshtml");}

</div>
@section  scripts {
    <script>
        var isVibe = document.body.classList.contains('theme-vibe');

        var jsIntervals = [];
        var iterations = 0;
        var maxIterations = 10;

        var delayBeforeInterval = 1000;
        var delayBeforeShowModal = 3500;   // passive run: delay from interval playing to reveal
        var delayBeforeShowScored = 6000;  // scored run: longer window to scan the options
        var delayBeforeHideModal = 3500;
        var revealDelay = delayBeforeShowModal;
        var delayBetweenIterations = delayBeforeInterval + revealDelay + delayBeforeHideModal;

        // ── Scoring quiz state (Vibe mode only) ──
        var quizLabels = ['DO MI (Maj 3rd)', 'FA LA (Maj 3rd)', 'SO TI (Maj 3rd)', 'MI DO (Min 6th)', 'LA FA (Min 6th)', 'TI SO (Min 6th)'];
        var currentAnswer = '';
        var quizAnswered = false;
        var quizCorrect = 0;
        var quizTotal = 0;
        var quizStreak = 0;
        var autoScoring = false;

        var GAUGE_RADIUS = 52;
        var GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;   // ~326.726

        $(document).ready(function () {
            setAudDrillSrc();

            $('input[type=radio][name=intervaltype]').change(function () {
                setAudDrillSrc();
                if (isVibe) renderQuizOptions();   // available drills changed
            });
            $('.cb-include').change(function () {
                setAudDrillSrc();
                if (isVibe) renderQuizOptions();   // available drills changed
            });

            if (isVibe) initQuiz();
        });

        function setAudDrillSrc() {
            $('#spinner').show();
            var baseSrc = '@Url.Action("GetHarmonicDrillEx", "L1C2", new { doNoteName = ViewBag.Pitch.PitchName })';

            // Get the drills based on what the user has choosen.
            var intervalType = $("input[type=radio][name=intervaltype]:checked").attr('id');

            var minDrill;
            var maxDrill;
            var excluded = getExcluded(null, 0);

            switch (intervalType) {
                case 'maj3rds':
                    minDrill = 0;
                    maxDrill = 2;
                    $('#maj-3rd-prompts').fadeIn();
                    $('#min-6th-prompts').fadeOut();
                    break;

                case 'min6ths':
                    minDrill = 3;
                    maxDrill = 5;
                    $('#maj-3rd-prompts').fadeOut();
                    $('#min-6th-prompts').fadeIn();
                    break;

                case 'both':
                    minDrill = 0;
                    maxDrill = 5;
                    $('#maj-3rd-prompts').fadeIn();
                    $('#min-6th-prompts').fadeIn();
                    break;

                default:
                    var msg = 'intervalType ' + intervalType + ' is not supported';
                    consoleAndToastr(msg);
            }

            var randomInt = getRandomInt(minDrill, maxDrill, excluded);

            var src = baseSrc + '&type=' + randomInt;
            $('#audDrill').attr('src', src);

            var msg = '';
            switch (randomInt) {
                case 0:
                    msg = msg + 'DO MI (Maj 3rd)';
                    break;
                case 1:
                    msg = msg + 'FA LA (Maj 3rd)';
                    break;
                case 2:
                    msg = msg + 'SO TI (Maj 3rd)';
                    break;
                case 3:
                    msg = msg + 'MI DO (Min 6th)';
                    break;
                case 4:
                    msg = msg + 'LA FA (Min 6th)';
                    break;
                case 5:
                    msg = msg + 'TI SO (Min 6th)';
                    break;
            }

            $('#drill1').text(msg);
            $('#spinner').fadeOut("slow");

            currentAnswer = msg;
            if (isVibe) resetQuizQuestion();
        }

        function automate() {
            var buttonText = $("#btnAutomate").text();
            switch (buttonText) {
                case "Go!":
                    autoScoring = isVibe && $('#cbScoreAuto').is(':checked');
                    if (autoScoring) resetScore();
                    revealDelay = autoScoring ? delayBeforeShowScored : delayBeforeShowModal;
                    delayBetweenIterations = delayBeforeInterval + revealDelay + delayBeforeHideModal;
                    iterations = 0;   // start each run fresh (don't carry over from a prior Stop)
                    $("#btnAutomate").text("Stop");
                    playAndShow();
                    var jsInterval = setInterval(playAndShow, delayBetweenIterations);
                    jsIntervals.push(jsInterval);
                    break;

                case "Stop":
                    autoScoring = false;
                    $("#btnAutomate").text("Go!");
                    resetIterationsMessage();
                    clearAllIntervals();
                    break;

                default:
                    alert("'" + buttonText + "' is not supported.");
                    break;
            }
        }

        function playAndShow() {
            iterations += 1;
            if (iterations > maxIterations) {
                $("#btnAutomate").text("Go!");
                resetIterationsMessage();
                iterations = 0;
                autoScoring = false;
                clearAllIntervals();
                return;
            }
            else {
                $("#remainingIterations").text("Playing " + iterations + " of " + maxIterations + " iterations.");
            }

            setTimeout(playInterval, delayBeforeInterval);
        }

        function playInterval() {
            setAudDrillSrc();
            $('#audDrill').trigger("play");
            setTimeout(showModal, revealDelay);
        }

        function showModal() {
            if (autoScoring && !quizAnswered) markMissed();
            $("#revealModalBody").html($("#drill1").html());
            $("#revealModal").modal('show');
            setTimeout(hideModal, delayBeforeHideModal);
        }

        function hideModal() {
            $("#revealModal").modal('hide');
        }

        function clearAllIntervals() {
            for (var id of this.jsIntervals) {
                clearInterval(id);
            }

            jsIntervals = [];
        }

        function resetIterationsMessage() {
            $("#remainingIterations").text("Automation will stop after " + maxIterations + " iterations.");
        }

        // ── Scoring quiz (Vibe mode only — card lives in .vibe-only div) ────────
        function initQuiz() {
            renderQuizOptions();
            $('#quizOptions').on('click', '.quiz-option', function () {
                if (!$(this).prop('disabled')) submitGuess($(this).attr('data-answer'));
            });
            var fill = document.getElementById('gaugeFill');
            if (fill) {
                fill.style.strokeDasharray = GAUGE_CIRCUMFERENCE;
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            }
            updateScoreDisplay();
            resetQuizQuestion();
        }

        // The drills that can actually play depend on the Maj 3rd / Min 6th / Both toggle
        // and the "Include in Drills" checkboxes — only offer those drills' labels.
        function getPlayableLabels() {
            var intervalType = $("input[type=radio][name=intervaltype]:checked").attr('id');
            var min = 0, max = 5;
            if (intervalType === 'maj3rds') { max = 2; }
            else if (intervalType === 'min6ths') { min = 3; }
            var labels = [];
            for (var t = min; t <= max; t++) {
                if ($('#cb-include-' + t).is(':checked')) labels.push(quizLabels[t]);
            }
            return labels;
        }

        function renderQuizOptions() {
            var opts = getPlayableLabels();
            var html = '';
            for (var i = 0; i < opts.length; i++) {
                html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-answer="' + opts[i] + '">' + opts[i] + '</button>';
            }
            $('#quizOptions').html(html);
        }

        function submitGuess(guess) {
            if (quizAnswered) return;
            quizAnswered = true;
            quizTotal += 1;

            var $options = $('.quiz-option');
            $options.prop('disabled', true);

            if (guess === currentAnswer) {
                quizCorrect += 1;
                quizStreak += 1;
                $('#quizFeedback').html('<i class="fa fa-check"></i> Correct!')
                    .removeClass('text-danger').addClass('text-success');
                $options.filter('[data-answer="' + currentAnswer + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-success');
            } else {
                quizStreak = 0;
                $('#quizFeedback').html('<i class="fa fa-times"></i> Not quite — it was ' + currentAnswer + '.')
                    .removeClass('text-success').addClass('text-danger');
                $options.filter('[data-answer="' + guess + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-danger');
                $options.filter('[data-answer="' + currentAnswer + '"]')
                    .removeClass('btn-outline-primary').addClass('btn-success');
            }
            updateScoreDisplay();
        }

        function markMissed() {
            quizAnswered = true;
            quizTotal += 1;
            quizStreak = 0;
            $('.quiz-option').prop('disabled', true)
                .filter('[data-answer="' + currentAnswer + '"]').removeClass('btn-outline-primary').addClass('btn-success');
            $('#quizFeedback').html('<i class="fa fa-times"></i> Time\'s up — it was ' + currentAnswer + '.')
                .removeClass('text-success').addClass('text-danger');
            updateScoreDisplay();
        }

        function resetQuizQuestion() {
            quizAnswered = false;
            $('.quiz-option').prop('disabled', false)
                .removeClass('btn-success btn-danger').addClass('btn-outline-primary');
            $('#quizFeedback').html('').removeClass('text-success text-danger');
        }

        function updateScoreDisplay() {
            $('#quizScore').text('Score: ' + quizCorrect + ' / ' + quizTotal);
            $('#quizStreak').text('Streak: ' + quizStreak);
            updateGauge();
        }

        function gaugeTierFor(pct) {
            if (pct >= 90) return { color: '#c99700', label: 'Quite Good', glow: true };
            if (pct >= 70) return { color: '#28a745', label: 'Very Good',  glow: false };
            if (pct >= 50) return { color: '#fd7e14', label: 'Good Work',  glow: false };
            return             { color: '#dc3545', label: 'Good Start', glow: false };
        }

        function updateGauge() {
            var fill   = document.getElementById('gaugeFill');
            var pctEl  = document.getElementById('gaugePct');
            var tierEl = document.getElementById('gaugeTier');
            if (!fill || !pctEl || !tierEl) return;

            if (quizTotal === 0) {
                pctEl.textContent = '—';
                tierEl.textContent = 'Play an interval';
                tierEl.style.color = '#6c757d';
                fill.style.stroke = '#adb5bd';
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
                fill.classList.remove('gauge-glow');
                return;
            }

            var pct = Math.round((quizCorrect / quizTotal) * 100);
            var tier = gaugeTierFor(pct);
            pctEl.textContent = pct + '%';
            tierEl.textContent = tier.label;
            tierEl.style.color = tier.color;
            fill.style.stroke = tier.color;
            fill.classList.toggle('gauge-glow', tier.glow);

            // Re-animate on every answer, even when pct is unchanged: replay the ring's fill
            // sweep from empty up to the current value, plus a brief scale pop.
            var gauge = document.querySelector('.score-gauge');
            var target = GAUGE_CIRCUMFERENCE * (1 - pct / 100);
            fill.style.transition = 'none';
            fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;   // reset ring to empty
            if (gauge) gauge.classList.remove('gauge-pulse');
            void (gauge ? gauge.offsetWidth : fill.getBoundingClientRect());   // one reflow commits the reset
            fill.style.transition = '';                          // restore the CSS 0.7s sweep
            fill.style.strokeDashoffset = target;                // sweep empty -> current value
            if (gauge) gauge.classList.add('gauge-pulse');       // replay the scale pop
        }

        function resetScore() {
            quizCorrect = 0;
            quizTotal = 0;
            quizStreak = 0;
            updateScoreDisplay();
            resetQuizQuestion();
        }

    </script>
}
