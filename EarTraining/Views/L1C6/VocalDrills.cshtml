@section  scripts {
    <script>
        var isVibe = document.body.classList.contains('theme-vibe');

        // ── Scoring quiz state (Vibe only) ──
        // The same 10 syllable patterns serve both Maj 2nd and Min 7th drills, so the quiz
        // identifies the pattern heard and dedupes by syllables (gated by toggle + includes).
        var drillSyllables = {
            0: 'DO DO RE RE DO', 1: 'RE RE MI MI MI', 2: 'FA FA SO SO SO', 3: 'SO SO LA LA SO', 4: 'LA LA TI TI DO',
            5: 'RE RE DO DO DO', 6: 'MI MI RE RE DO', 7: 'SO SO FA FA MI', 8: 'LA LA SO SO SO', 9: 'TI TI LA LA SO',
            10: 'RE RE DO DO DO', 11: 'MI MI RE RE DO', 12: 'SO SO FA FA MI', 13: 'LA LA SO SO SO', 14: 'TI TI LA LA SO',
            15: 'DO DO RE RE DO', 16: 'RE RE MI MI MI', 17: 'FA FA SO SO SO', 18: 'SO SO LA LA SO', 19: 'LA LA TI TI DO'
        };
        var quizSyllableOptions = ['DO DO RE RE DO', 'RE RE MI MI MI', 'FA FA SO SO SO', 'SO SO LA LA SO', 'LA LA TI TI DO', 'RE RE DO DO DO', 'MI MI RE RE DO', 'SO SO FA FA MI', 'LA LA SO SO SO', 'TI TI LA LA SO'];
        var currentAnswer = null;
        var quizAnswered = false;
        var quizCorrect = 0;
        var quizTotal = 0;
        var quizStreak = 0;

        var GAUGE_RADIUS = 52;
        var GAUGE_CIRCUMFERENCE = 2 * Math.PI * GAUGE_RADIUS;   // ~326.726

        $(document).ready(function () {
            setAudDrill1Src();

            $('input[type=radio][name=intervaltype]').change(function () {
                setAudDrill1Src();
                if (isVibe) renderQuizOptions();   // available drills changed
            });

            $('.cb-include').change(function () {
                setAudDrill1Src();
                if (isVibe) renderQuizOptions();   // available drills changed
            });

            if (isVibe) initQuiz();
        });

        function setAudDrill1Src() {
            $('#spinner').show();
            var baseSrc = '@Url.Action("GetMelodicDrillEx", "L1C6", new { doNoteName = ViewBag.Pitch.PitchName })';

            // Get the drills based on what the user has choosen.
            var intervalType = $("input[type=radio][name=intervaltype]:checked").attr('id');

            var minDrill;
            var maxDrill;
            var excluded = getExcluded(null, 0);

            switch (intervalType) {
                case 'maj2nds':
                    minDrill = 0;
                    maxDrill = 9;
                    $('#maj-2nd-prompts').fadeIn();
                    $('#min-7th-prompts').fadeOut();
                    break;

                case 'min7ths':
                    minDrill = 10;
                    maxDrill = 19;
                    $('#maj-2nd-prompts').fadeOut();
                    $('#min-7th-prompts').fadeIn();
                    break;

                case 'both':
                    minDrill = 0;
                    maxDrill = 19;
                    $('#maj-2nd-prompts').fadeIn();
                    $('#min-7th-prompts').fadeIn();
                    break;

                default:
                    var msg = 'intervalType ' + intervalType + ' is not supported';
                    consoleAndToastr(msg);
            }

            var randomInt = getRandomInt(minDrill, maxDrill, excluded);

            var src = baseSrc + '&type=' + randomInt;
            $('#audDrill1').attr('src', src);

            var msg = '';
            switch (randomInt) {
                case 0:
                    msg = msg + 'DO DO RE RE DO';
                    break;
                case 1:
                    msg = msg + 'RE RE MI MI MI';
                    break;
                case 2:
                    msg = msg + 'FA FA SO SO SO';
                    break;
                case 3:
                    msg = msg + 'SO SO LA LA SO';
                    break;
                case 4:
                    msg = msg + 'LA LA TI TI DO';
                    break;
                case 5:
                    msg = msg + 'RE RE DO DO DO';
                    break;
                case 6:
                    msg = msg + 'MI MI RE RE DO';
                    break;
                case 7:
                    msg = msg + 'SO SO FA FA MI';
                    break;
                case 8:
                    msg = msg + 'LA LA SO SO SO';
                    break;
                case 9:
                    msg = msg + 'TI TI LA LA SO';
                    break;
                case 10:
                    msg = msg + 'RE RE DO DO DO';
                    break;
                case 11:
                    msg = msg + 'MI MI RE RE DO';
                    break;
                case 12:
                    msg = msg + 'SO SO FA FA MI';
                    break;
                case 13:
                    msg = msg + 'LA LA SO SO SO';
                    break;
                case 14:
                    msg = msg + 'TI TI LA LA SO';
                    break;
                case 15:
                    msg = msg + 'DO DO RE RE DO';
                    break;
                case 16:
                    msg = msg + 'RE RE MI MI MI';
                    break;
                case 17:
                    msg = msg + 'FA FA SO SO SO';
                    break;
                case 18:
                    msg = msg + 'SO SO LA LA SO';
                    break;
                case 19:
                    msg = msg + 'LA LA TI TI DO';
                    break;
                default:
                    consoleAndToastr('randomInt ' + randomInt + ' is not supported.');
                    break;
            }

            $('#drill1').text(msg);

            if (isVibe) {
                currentAnswer = msg;
                resetQuizQuestion();
            }
            $('#spinner').fadeOut("slow");
        }

        // ── Scoring quiz (Vibe only — card lives in .vibe-only div) ──
        function initQuiz() {
            renderQuizOptions();
            $('#quizOptions').on('click', '.quiz-option', function () {
                if (!$(this).prop('disabled')) submitGuess($(this).attr('data-answer'));
            });
            var fill = document.getElementById('gaugeFill');
            if (fill) {
                fill.style.strokeDasharray = GAUGE_CIRCUMFERENCE;
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            }
            updateScoreDisplay();
            resetQuizQuestion();
        }

        // The drills that can play depend on the Maj 2nd / Min 7th toggle and "Include in
        // Drills" (types 0-9 = Maj 2nd, 10-19 = Min 7th); dedupe to one button per pattern.
        function getPlayableLabels() {
            var intervalType = $("input[type=radio][name=intervaltype]:checked").attr('id');
            var min = 0, max = 19;
            if (intervalType === 'maj2nds') { max = 9; }
            else if (intervalType === 'min7ths') { min = 10; }
            var available = {};
            for (var t = min; t <= max; t++) {
                if (drillSyllables[t] && $('#cb-include-' + t).is(':checked')) available[drillSyllables[t]] = true;
            }
            return quizSyllableOptions.filter(function (s) { return available[s]; });
        }

        function renderQuizOptions() {
            var opts = getPlayableLabels();
            var html = '';
            for (var i = 0; i < opts.length; i++) {
                html += '<button type="button" class="btn btn-outline-primary quiz-option mr-2 mb-2" data-answer="' + opts[i] + '">' + opts[i] + '</button>';
            }
            $('#quizOptions').html(html);
        }

        function submitGuess(guess) {
            if (quizAnswered || !currentAnswer) return;
            quizAnswered = true;
            quizTotal += 1;

            var $options = $('.quiz-option');
            $options.prop('disabled', true);

            if (guess === currentAnswer) {
                quizCorrect += 1;
                quizStreak += 1;
                $('#quizFeedback').html('<i class="fa fa-check"></i> Correct!')
                    .removeClass('text-danger').addClass('text-success');
            } else {
                quizStreak = 0;
                $('#quizFeedback').html('<i class="fa fa-times"></i> Not quite — it was ' + currentAnswer + '.')
                    .removeClass('text-success').addClass('text-danger');
                $options.filter('[data-answer="' + guess + '"]').removeClass('btn-outline-primary').addClass('btn-danger');
            }
            $options.filter('[data-answer="' + currentAnswer + '"]').removeClass('btn-outline-primary').addClass('btn-success');
            updateScoreDisplay();
        }

        function resetQuizQuestion() {
            quizAnswered = false;
            $('.quiz-option').prop('disabled', false)
                .removeClass('btn-success btn-danger').addClass('btn-outline-primary');
            $('#quizFeedback').html('').removeClass('text-success text-danger');
        }

        function updateScoreDisplay() {
            $('#quizScore').text('Score: ' + quizCorrect + ' / ' + quizTotal);
            $('#quizStreak').text('Streak: ' + quizStreak);
            updateGauge();
        }

        function gaugeTierFor(pct) {
            if (pct >= 90) return { color: '#c99700', label: 'Quite Good', glow: true };
            if (pct >= 70) return { color: '#28a745', label: 'Very Good',  glow: false };
            if (pct >= 50) return { color: '#fd7e14', label: 'Good Work',  glow: false };
            return             { color: '#dc3545', label: 'Good Start', glow: false };
        }

        function updateGauge() {
            var fill   = document.getElementById('gaugeFill');
            var pctEl  = document.getElementById('gaugePct');
            var tierEl = document.getElementById('gaugeTier');
            if (!fill || !pctEl || !tierEl) return;

            if (quizTotal === 0) {
                pctEl.textContent = '—';
                tierEl.textContent = 'Play a drill';
                tierEl.style.color = '#6c757d';
                fill.style.stroke = '#adb5bd';
                fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
                fill.classList.remove('gauge-glow');
                return;
            }

            var pct = Math.round((quizCorrect / quizTotal) * 100);
            var tier = gaugeTierFor(pct);
            pctEl.textContent = pct + '%';
            tierEl.textContent = tier.label;
            tierEl.style.color = tier.color;
            fill.style.stroke = tier.color;
            fill.classList.toggle('gauge-glow', tier.glow);

            // Re-animate on every answer, even when pct is unchanged: replay the ring's fill
            // sweep from empty up to the current value, plus a brief scale pop.
            var gauge = document.querySelector('.score-gauge');
            var target = GAUGE_CIRCUMFERENCE * (1 - pct / 100);
            fill.style.transition = 'none';
            fill.style.strokeDashoffset = GAUGE_CIRCUMFERENCE;
            if (gauge) gauge.classList.remove('gauge-pulse');
            void (gauge ? gauge.offsetWidth : fill.getBoundingClientRect());
            fill.style.transition = '';
            fill.style.strokeDashoffset = target;
            if (gauge) gauge.classList.add('gauge-pulse');
        }

        function resetScore() {
            quizCorrect = 0;
            quizTotal = 0;
            quizStreak = 0;
            updateScoreDisplay();
            resetQuizQuestion();
        }

    </script>
}