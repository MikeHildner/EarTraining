@section scripts
{
    <script>
        $(function () {
            var isVibe = document.body.classList.contains('theme-vibe');
            var draw = isVibe ? drawRatioAnimated : drawRatio;

            draw("unison",       1,  1);
            draw("minor2nd",    16, 15);
            draw("major2nd",     9,  8);
            draw("minor3rd",     6,  5);
            draw("major3rd",     5,  4);
            draw("perfect4th",   4,  3);
            //draw("tritone75", 7, 5);
            draw("tritone107",  10,  7);
            draw("perfect5th",   3,  2);
            draw("minor6th",     8,  5);
            draw("major6th",     5,  3);
            draw("minor7th",    16,  9);
            draw("major7th",    15,  8);
            draw("perfectOctave", 2, 1);
        });

        // ── Original (Human mode) ────────────────────────────────────────────
        function drawRatio(element, numerator, denominator) {
            var svgns = "http://www.w3.org/2000/svg",
                container = document.getElementById(element);
            var height = $(container).attr("height");
            var width  = $(container).attr("width");

            var circleRadius = 11.5;
            var svgXCenter = width / 2;
            var svgYCenter = (height / 2) - 1;
            var numeratorStartX   = svgXCenter - circleRadius * (numerator - 1)   - 1;
            var denominatorStartX = svgXCenter - circleRadius * (denominator - 1) - 1;

            for (var i = 0; i < numerator; i++) {
                var circle = document.createElementNS(svgns, 'circle');
                circle.setAttributeNS(null, 'cx', numeratorStartX);
                circle.setAttributeNS(null, 'cy', svgYCenter);
                circle.setAttributeNS(null, 'r',  circleRadius);
                circle.setAttributeNS(null, 'style', 'fill: none; stroke: blue; stroke-width: 1px;');
                container.appendChild(circle);
                numeratorStartX += circleRadius * 2;
            }

            for (var i = 0; i < denominator; i++) {
                var circle = document.createElementNS(svgns, 'circle');
                circle.setAttributeNS(null, 'cx', denominatorStartX);
                circle.setAttributeNS(null, 'cy', svgYCenter);
                circle.setAttributeNS(null, 'r',  circleRadius);
                circle.setAttributeNS(null, 'style', 'fill: none; stroke: red; stroke-width: 1px;');
                container.appendChild(circle);
                denominatorStartX += circleRadius * 2;
            }
        }

        // ── Animated (Vibe mode) ─────────────────────────────────────────────
        // Each circle draws itself in using a stroke-dashoffset animation.
        // Numerator circles (blue-purple) appear first, one by one; then
        // denominator circles (coral-red) follow after a brief pause.
        function drawRatioAnimated(element, numerator, denominator) {
            var svgns     = "http://www.w3.org/2000/svg";
            var container = document.getElementById(element);
            var height    = parseInt(container.getAttribute("height"));
            var width     = parseInt(container.getAttribute("width"));

            var r    = 11.5;
            var circ = 2 * Math.PI * r;   // ≈ 72.26
            var cx0  = width  / 2;
            var cy   = height / 2 - 1;

            var circleDelay = 55;   // ms between successive circles
            var layerGap    = 220;  // ms pause between numerator and denominator groups

            function spawnCircle(cx, color, delay) {
                setTimeout(function () {
                    var c = document.createElementNS(svgns, 'circle');
                    c.setAttribute('cx', cx);
                    c.setAttribute('cy', cy);
                    c.setAttribute('r',  r);
                    // Start invisible and un-drawn
                    c.style.fill            = 'none';
                    c.style.stroke          = color;
                    c.style.strokeWidth     = '1.5';
                    c.style.strokeDasharray = circ;
                    c.style.strokeDashoffset = circ;
                    c.style.opacity         = '0';
                    container.appendChild(c);

                    // Double rAF: first frame registers the initial state,
                    // second frame triggers the transition from it.
                    requestAnimationFrame(function () {
                        requestAnimationFrame(function () {
                            c.style.transition = [
                                'stroke-dashoffset 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)',
                                'opacity 0.18s ease'
                            ].join(', ');
                            c.style.strokeDashoffset = '0';
                            c.style.opacity = '1';
                        });
                    });
                }, delay);
            }

            // Numerator group (blue-purple)
            var numStartX = cx0 - r * (numerator - 1) - 1;
            for (var i = 0; i < numerator; i++) {
                spawnCircle(numStartX + i * r * 2, '#5b7cf6', i * circleDelay);
            }

            // Denominator group (coral-red) — begins after the last numerator
            // circle has started drawing, plus a short rest.
            var denOffset  = (numerator - 1) * circleDelay + layerGap;
            var denStartX  = cx0 - r * (denominator - 1) - 1;
            for (var j = 0; j < denominator; j++) {
                spawnCircle(denStartX + j * r * 2, '#f05575', denOffset + j * circleDelay);
            }
        }
    </script>
}